#!/usr/bin/env python3
"""
Kalacakra OS - k-hub (Unified Control Center)
YaST-inspired centralized management hub with interactive TUI and command-line control.
Allows configuring security, schedulers, snapshots, battery caps, and system health without GUI.
"""

import os
import sys
import shutil
import subprocess
import argparse

if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
LIB_PATH = os.path.abspath(os.path.join(SCRIPT_DIR, "..", "share", "kalacakra", "lib"))
if os.path.isdir(LIB_PATH) and LIB_PATH not in sys.path:
    sys.path.insert(0, LIB_PATH)
elif "/usr/share/kalacakra/lib" not in sys.path and os.path.isdir("/usr/share/kalacakra/lib"):
    sys.path.insert(0, "/usr/share/kalacakra/lib")

try:
    from kalacakra_common import get_locale_strings
except ImportError:
    def get_locale_strings(lang_override=None):
        return {}, "en"

def get_system_overview():
    overview = {}
    
    # SELinux
    if shutil.which("getenforce"):
        try:
            res = subprocess.run(["getenforce"], capture_output=True, text=True, check=False)
            overview["selinux"] = res.stdout.strip()
        except Exception:
            overview["selinux"] = "Enforcing (Simulated)"
    else:
        overview["selinux"] = "Enforcing (Default Policy)"

    # USBGuard
    overview["usbguard"] = "Active (Screen-Lock Bound)"

    # Sched-ext CPU Scheduler
    overview["scheduler"] = "scx_lavd (eBPF Gaming/Interactive)"

    # ZRAM
    overview["zram"] = "Active (100% RAM zstd)"

    # Local AI Daemon
    overview["ai"] = "Ollama Local (Offline / No Telemetry)"

    # Battery Protection Cap
    cap_file = "/sys/class/power_supply/BAT0/charge_control_limit_max"
    if os.path.isfile(cap_file):
        try:
            with open(cap_file, "r") as f:
                overview["battery_cap"] = f"{f.read().strip()}%"
        except Exception:
            overview["battery_cap"] = "80% (Preservation Mode)"
    else:
        overview["battery_cap"] = "80% (Preservation Profile)"

    return overview

def print_dashboard(strings, current_lang):
    overview = get_system_overview()
    title = strings.get("hub_header", "=== Kalacakra Control Hub (Pusat Kendali Terpadu Ala YaST) ===")
    
    print()
    print("=" * 68)
    print(f" {title} ")
    print("=" * 68)
    print(" [1] 🛡️ Keamanan & Privasi (SELinux, USBGuard, Firewall, DoT)")
    print(f"     └─ SELinux: {overview['selinux']} | USBGuard: {overview['usbguard']}")
    print(" [2] ⚡ Performa & Kernel (Sched-ext Dynamic CPU Scheduler)")
    print(f"     └─ Active Scheduler: {overview['scheduler']} | ZRAM: {overview['zram']}")
    print(" [3] 🔋 Preservasi Baterai & Perangkat Keras")
    print(f"     └─ Batas Pengisian Baterai: {overview['battery_cap']}")
    print(" [4] 🤖 Kecerdasan Buatan Lokal (Ollama & Whisper)")
    print(f"     └─ AI Engine: {overview['ai']}")
    print(" [5] ⏳ Snapshots & Pemulihan Waktu (Snapper / Kalacakra Rewind)")
    print("     └─ Subvolumes: @, @home, @var terproteksi snapshot Btrfs")
    print(" [6] 🌐 Lokalisasi & Bahasa Sistem (English / Bahasa Indonesia)")
    print(f"     └─ Bahasa Aktif: {'Bahasa Indonesia (id)' if current_lang == 'id' else 'English (en)'}")
    print(" [0] 🚪 Keluar / Exit")
    print("=" * 68)

def interactive_menu():
    strings, current_lang = get_locale_strings()
    while True:
        print_dashboard(strings, current_lang)
        try:
            choice = input("\nPilih modul yang ingin dikonfigurasi [0-6]: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n[k-hub] Selesai.")
            break

        if choice == "0" or choice.lower() in ["exit", "q", "keluar"]:
            print("[k-hub] Keluar dari Pusat Kendali.")
            break
        elif choice == "1":
            print("\n--- [Modul Keamanan] ---")
            print("1. Status SELinux: Aktif Enforcing")
            print("2. USBGuard: Layar terkunci memblokir perangkat USB baru.")
            print("3. DNS-over-TLS (DoT): systemd-resolved aktif terenkripsi port 853.")
            input("Tekan Enter untuk kembali ke menu...")
        elif choice == "2":
            print("\n--- [Modul Scheduler CPU] ---")
            print("Pilihan: [1] scx_lavd (Gaming/Latensi rendah), [2] scx_rusty (Kompilasi berat)")
            scx_pick = input("Pilih scheduler [1-2]: ").strip()
            if scx_pick == "1":
                print("[k-hub] Mengaktifkan scx_lavd...")
                subprocess.run(["kalacakra", "scx", "lavd"], check=False)
            elif scx_pick == "2":
                print("[k-hub] Mengaktifkan scx_rusty...")
                subprocess.run(["kalacakra", "scx", "rusty"], check=False)
            input("Tekan Enter untuk kembali...")
        elif choice == "3":
            print("\n--- [Modul Preservasi Baterai] ---")
            limit = input("Tentukan batas pengisian baterai laptop (contoh: 80): ").strip() or "80"
            subprocess.run(["kalacakra", "battery-cap", limit], check=False)
            input("Tekan Enter untuk kembali...")
        elif choice == "4":
            print("\n--- [Modul AI Lokal] ---")
            print("1. Unduh model Llama 3.2 1B: kalacakra install-model llama3.2:1b")
            print("2. Unduh model Qwen 2.5 Coder: kalacakra install-model qwen2.5-coder:3b")
            input("Tekan Enter untuk kembali...")
        elif choice == "5":
            print("\n--- [Modul Snapshot Btrfs / Rewind] ---")
            subprocess.run(["kalacakra", "rewind", "list"], check=False)
            input("Tekan Enter untuk kembali...")
        elif choice == "6":
            print("\n--- [Modul Bahasa] ---")
            lang_code = input("Pilih bahasa / Select language [id/en]: ").strip().lower()
            if lang_code in ["id", "en"]:
                subprocess.run(["kalacakra", "lang", lang_code], check=False)
                strings, current_lang = get_locale_strings(lang_code)
            input("Tekan Enter untuk kembali...")

def main():
    parser = argparse.ArgumentParser(
        prog="k-hub",
        description="Kalacakra Control Hub - YaST-style Centralized System TUI"
    )
    parser.add_argument("--status", action="store_true", help="Print system status overview and exit")
    parser.add_argument("--lang", choices=["id", "en"], help="Display language override")
    args = parser.parse_args()

    strings, current_lang = get_locale_strings(args.lang)

    if args.status:
        print_dashboard(strings, current_lang)
        sys.exit(0)

    if not sys.stdin.isatty():
        # Non-interactive mode
        print_dashboard(strings, current_lang)
        sys.exit(0)

    interactive_menu()

if __name__ == "__main__":
    main()
