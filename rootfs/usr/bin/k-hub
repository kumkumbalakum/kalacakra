#!/usr/bin/env python3
"""
Kalacakra OS - k-hub (Unified Control Center)
YaST-inspired centralized management hub with interactive TUI and command-line control.
Allows configuring security, schedulers, snapshots, battery caps, and system health without GUI.
"""

import os
import sys
import shutil
import subprocess
import argparse

if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Path library bersama ditangani oleh _kalacakra_bootstrap.

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import get_locale_strings

def get_system_overview():
    """Ambil status sistem SEBENARNYA - tanpa nilai simulasi/hardcode."""
    overview = {}

    def _run(cmd):
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, check=False)
            return res.stdout.strip()
        except Exception:
            return ""

    # SELinux (query nyata)
    if shutil.which("getenforce"):
        overview["selinux"] = _run(["getenforce"]) or "Unknown"
    else:
        overview["selinux"] = "getenforce tidak tersedia"

    # USBGuard (query nyata)
    overview["usbguard"] = "Active" if _run(["systemctl", "is-active", "usbguard"]) == "active" else "Nonaktif"

    # Sched-ext CPU Scheduler (query proses nyata)
    sched = _run(["pgrep", "-a", "-f", "scx_"])
    if sched:
        overview["scheduler"] = sched.split()[0] if sched.split() else "SCX aktif"
    else:
        overview["scheduler"] = "Default kernel (EEVDF)"

    # ZRAM (query nyata)
    overview["zram"] = "Active (zstd)" if "zram0" in _run(["zramctl"]) else "Inactive"

    # Local AI Daemon (query nyata)
    ai = _run(["systemctl", "--user", "is-active", "kalacakra-ai.service"])
    overview["ai"] = "Ollama Running (localhost:11434)" if ai == "active" else "Standby / Nonaktif"

    # Battery Protection Cap (query nyata dari sysfs)
    overview["battery_cap"] = "-"
    for bat in ("/sys/class/power_supply/BAT0", "/sys/class/power_supply/BAT1"):
        for fname in ("charge_control_limit_max", "charge_stop_threshold"):
            cap_file = os.path.join(bat, fname)
            if os.path.isfile(cap_file):
                try:
                    with open(cap_file, "r") as f:
                        overview["battery_cap"] = f"{f.read().strip()}%"
                except Exception:
                    pass
                break
        if overview["battery_cap"] != "-":
            break
    if overview["battery_cap"] == "-":
        overview["battery_cap"] = "Tanpa baterai / default 100%"

    return overview

def print_dashboard(strings, current_lang):
    overview = get_system_overview()
    title = strings.get("hub_header", "=== Kalacakra Control Hub (Pusat Kendali Terpadu Ala YaST) ===")
    
    print()
    print("=" * 68)
    print(f" {title} ")
    print("=" * 68)
    print(" [1] 🛡️ Keamanan & Privasi (SELinux, USBGuard, Firewall, DoT)")
    print(f"     └─ SELinux: {overview['selinux']} | USBGuard: {overview['usbguard']}")
    print(" [2] ⚡ Performa & Kernel (Sched-ext Dynamic CPU Scheduler)")
    print(f"     └─ Active Scheduler: {overview['scheduler']} | ZRAM: {overview['zram']}")
    print(" [3] 🔋 Preservasi Baterai & Perangkat Keras")
    print(f"     └─ Batas Pengisian Baterai: {overview['battery_cap']}")
    print(" [4] 🤖 Kecerdasan Buatan Lokal (Ollama & Whisper)")
    print(f"     └─ AI Engine: {overview['ai']}")
    print(" [5] ⏳ Snapshots & Pemulihan Waktu (Snapper / Kalacakra Rewind)")
    print("     └─ Snapshot Btrfs via Snapper (cek: kalacakra rewind list)")
    print(" [6] 🌐 Lokalisasi & Bahasa Sistem (English / Bahasa Indonesia)")
    print(f"     └─ Bahasa Aktif: {'Bahasa Indonesia (id)' if current_lang == 'id' else 'English (en)'}")
    print(" [7] 🎨 Identitas Visual (Kalacakra Look - ganti tema desktop)")
    print("     └─ 5 preset: Mandala Cyberpunk, Nusantara Bronze, Obsidian, Aurora, Kraton Gold")
    print(" [8] 👋 Panduan Penyambutan (Kalacakra Welcome - wizard bahasa/tema/AI)")
    print(" [9] 🔎 Pencarian Makna Lokal (Kalacakra Semantic - cari berkas via sinonim ID/EN)")
    print("     └─ Indeks lokal (TF-IDF+sinonim, bukan vektor). index/search/similar")
    print(" [10] 🤖 Agen Tugas Multi-Langkah (Kalacakra Agent - pratinjau rencana lalu eksekusi)")
    print("     └─ plan/run; jujur bila AI nonaktif & menolak perintah berbahaya")
    print(" [0] 🚪 Keluar / Exit")
    print("=" * 68)

def interactive_menu():
    strings, current_lang = get_locale_strings()
    while True:
        print_dashboard(strings, current_lang)
        try:
            choice = input("\nPilih modul yang ingin dikonfigurasi [0-6]: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n[k-hub] Selesai.")
            break

        if choice == "0" or choice.lower() in ["exit", "q", "keluar"]:
            print("[k-hub] Keluar dari Pusat Kendali.")
            break
        elif choice == "1":
            print("\n--- [Modul Keamanan] ---")
            print(f"1. Status SELinux: {get_system_overview()['selinux']}")
            print(f"2. USBGuard: {get_system_overview()['usbguard']}")
            print("3. DNS-over-TLS (DoT): cek 'resolvectl status | grep DNSOverTLS'")
            input("Tekan Enter untuk kembali ke menu...")
        elif choice == "2":
            print("\n--- [Modul Scheduler CPU] ---")
            print("Pilihan: [1] scx_lavd (Gaming/Latensi rendah), [2] scx_rusty (Kompilasi berat)")
            scx_pick = input("Pilih scheduler [1-2]: ").strip()
            if scx_pick == "1":
                print("[k-hub] Mengaktifkan scx_lavd...")
                subprocess.run(["kalacakra", "scx", "lavd"], check=False)
            elif scx_pick == "2":
                print("[k-hub] Mengaktifkan scx_rusty...")
                subprocess.run(["kalacakra", "scx", "rusty"], check=False)
            input("Tekan Enter untuk kembali...")
        elif choice == "3":
            print("\n--- [Modul Preservasi Baterai] ---")
            limit = input("Tentukan batas pengisian baterai laptop (contoh: 80): ").strip() or "80"
            subprocess.run(["kalacakra", "battery-cap", limit], check=False)
            input("Tekan Enter untuk kembali...")
        elif choice == "4":
            print("\n--- [Modul AI Lokal] ---")
            print("1. Unduh model Llama 3.2 1B: kalacakra install-model llama3.2:1b")
            print("2. Unduh model Qwen 2.5 Coder: kalacakra install-model qwen2.5-coder:3b")
            input("Tekan Enter untuk kembali...")
        elif choice == "5":
            print("\n--- [Modul Snapshot Btrfs / Rewind] ---")
            subprocess.run(["kalacakra", "rewind", "list"], check=False)
            input("Tekan Enter untuk kembali...")
        elif choice == "6":
            print("\n--- [Modul Bahasa] ---")
            lang_code = input("Pilih bahasa / Select language [id/en]: ").strip().lower()
            if lang_code in ["id", "en"]:
                subprocess.run(["kalacakra", "lang", lang_code], check=False)
                strings, current_lang = get_locale_strings(lang_code)
            input("Tekan Enter untuk kembali...")
        elif choice == "7":
            print("\n--- [Modul Identitas Visual / Kalacakra Look] ---")
            subprocess.run(["kalacakra", "look", "list"], check=False)
            print("\nTerapkan tema: kalacakra look apply <id> [--screenshot]")
            print("Rollback     : kalacakra look rollback")
            input("Tekan Enter untuk kembali...")
        elif choice == "8":
            print("\n--- [Panduan Penyambutan / Kalacakra Welcome] ---")
            subprocess.run(["kalacakra", "welcome"], check=False)
            input("Tekan Enter untuk kembali...")
        elif choice == "9":
            print("\n--- [Pencarian Makna Lokal / Kalacakra Semantic] ---")
            subprocess.run(["kalacakra", "semantic", "status"], check=False)
            print("\nBangun indeks : kalacakra semantic index ~/Documents")
            print("Cari          : kalacakra semantic search \"surat sewa tahun lalu\"")
            print("Mirip berkas  : kalacakra semantic similar <berkas>")
            input("Tekan Enter untuk kembali...")
        elif choice == "10":
            print("\n--- [Agen Tugas / Kalacakra Agent] ---")
            print("Contoh: kalacakra agent plan \"konversi semua PNG di Downloads ke WebP lalu zip\"")
            instr = input("Instruksi (kosongkan untuk batal): ").strip()
            if instr:
                subprocess.run(["kalacakra", "agent", "plan", instr], check=False)
            input("Tekan Enter untuk kembali...")

def main():
    parser = argparse.ArgumentParser(
        prog="k-hub",
        description="Kalacakra Control Hub - YaST-style Centralized System TUI"
    )
    parser.add_argument("--status", action="store_true", help="Print system status overview and exit")
    parser.add_argument("--lang", choices=["id", "en"], help="Display language override")
    args = parser.parse_args()

    strings, current_lang = get_locale_strings(args.lang)

    if args.status:
        print_dashboard(strings, current_lang)
        sys.exit(0)

    if not sys.stdin.isatty():
        # Non-interactive mode
        print_dashboard(strings, current_lang)
        sys.exit(0)

    interactive_menu()

if __name__ == "__main__":
    main()
