#!/usr/bin/env python3
"""
Kalacakra OS - k-doctor
Comprehensive System Health, Integrity & Maintenance Utility (Bilingual EN/ID)
Checks both the immutable OS core (bootc/ostree, SELinux, DoT, security services)
and day-to-day resources (Btrfs, ZRAM, containers, Flatpak, battery).
"""

import os
import sys
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Path library bersama ditangani oleh _kalacakra_bootstrap.

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import get_locale_strings

def run_cmd(cmd_list):
    try:
        res = subprocess.run(cmd_list, capture_output=True, text=True, check=False)
        return res.stdout.strip(), res.returncode
    except FileNotFoundError:
        return "", 127
    except Exception as e:
        return str(e), 1

# ==============================================================================
# Bagian A: Jantung OS Imutabel (Immutable Core)
# ==============================================================================

def check_bootc_status():
    """Status image bootable: jalur update atomik & robooth truntuk (rollback)."""
    out, code = run_cmd(["bootc", "status", "--json"])
    if code == 0 and out:
        try:
            import json
            data = json.loads(out)
            img = data.get("image", {})
            version = img.get("version", "unknown")
            # 'cached-update'/'update available' diserahkan ke pesan mentah bootc
            return "OK", f"bootc image deployed (version: {version})"
        except Exception:
            return "OK", "bootc image deployed"
    # Fallback ke rpm-ostree untuk image non-bootc
    out, code = run_cmd(["rpm-ostree", "status"])
    if code == 0 and out:
        for line in out.split("\n"):
            if "*" in line and ("ostree" in line or "ghcr.io" in line or "registry" in line):
                return "OK", line.strip()[:60]
        return "OK", "rpm-ostree deployment active"
    return "WARN", "bootc/rpm-ostree status tidak tersedia"

def check_rollback_protection():
    """Perlindungan rollback: bootloader harus mendukung pilih deployment lama.
    Indikator paling andal di bootc/ostree adalah jumlah deployment terdaftar;
    fallback ke deteksi lokasi bootloader (systemd-boot/GRUB)."""
    # 1. Cara paling akurat: ada >1 deployment = rollback benar-benar mungkin
    out, code = run_cmd(["rpm-ostree", "status", "--json"])
    if code == 0 and out:
        try:
            import json
            deployments = json.loads(out).get("deployments", [])
            if len(deployments) > 1:
                return "OK", f"{len(deployments)} deployment terdaftar (rollback tersedia)"
            if len(deployments) == 1:
                return "INFO", "Hanya 1 deployment - rollback ke versi lain belum tersedia"
        except Exception:
            pass

    # 2. Deteksi lokasi bootloader (systemd-boot & GRUB) - jalur nyata di Fedora bootc
    systemd_boot_markers = [
        "/boot/loader/entries",            # entri systemd-boot (bootc pakai ini)
        "/boot/efi/EFI/systemd",           # binary systemd-bootx64.efi
        "/boot/efi/EFI/BOOT",
    ]
    for path in systemd_boot_markers:
        if os.path.isdir(path):
            return "OK", "systemd-boot terdeteksi (menu multi-deployment aktif)"

    # GRUB: cek keberadaan direktori konfigurasi (bukan loader.1 yang tak standar)
    for path in ("/boot/grub2", "/boot/grub", "/boot/efi/EFI/fedora"):
        if os.path.isdir(path):
            return "OK", "GRUB terdeteksi (menu multi-deployment aktif)"

    # grub2-editenv menyimpan hitungan boot gagal (boot-counting ala systemd)
    out, code = run_cmd(["grub2-editenv", "list"])
    if code == 0 and out:
        return "OK", out.split("\n")[0][:60]
    return "INFO", "Tidak dapat memverifikasi menu boot cadangan"

def check_selinux():
    """SELinux harus Enforcing sesuai janji defense-in-depth."""
    out, code = run_cmd(["getenforce"])
    if code == 0:
        mode = out.strip()
        if mode == "Enforcing":
            return "OK", "Enforcing"
        if mode == "Permissive":
            return "WARN", "Permissive (seharusnya Enforcing)"
        return "WARN", mode or "Unknown"
    return "INFO", "getenforce tidak tersedia (bukan host Fedora)"

def check_dot_dns():
    """DNS-over-TLS via systemd-resolved (konfigurasi kalacakra-dot.conf)."""
    conf = "/etc/systemd/resolved.conf.d/kalacakra-dot.conf"
    out, code = run_cmd(["resolvectl", "status"])
    if code == 0 and "DNSOverTLS: yes" in out:
        return "OK", "DNSOverTLS aktif (Quad9/Cloudflare)"
    if os.path.isfile(conf):
        return "OK", "DoT config terpasang (resolved aktif)"
    return "WARN", "DoT tidak terkonfigurasi"

def check_firewall():
    """firewalld harus aktif (di-enable di Containerfile)."""
    out, code = run_cmd(["systemctl", "is-active", "firewalld"])
    if out == "active":
        return "OK", "Active"
    return "WARN", f"Nonaktif ({out or 'unknown'}) - seharusnya aktif"

def check_usbguard():
    """USBGuard harus aktif (blocked policy per perangkat tak dikenal)."""
    out, code = run_cmd(["systemctl", "is-active", "usbguard"])
    if out == "active":
        return "OK", "Active (unknown devices blocked)"
    return "WARN", f"Nonaktif ({out or 'unknown'}) - seharusnya aktif"

def check_tailscale():
    out, code = run_cmd(["systemctl", "is-active", "tailscaled"])
    if out == "active":
        return "OK", "Active"
    return "INFO", "Standby (mesh VPN tidak dipakai)"

def check_scheduler():
    """Sched-ext: scheduler aktif saat ini (default EEVDF jika tak ada scx_)."""
    out, code = run_cmd(["pgrep", "-a", "-f", "scx_"])
    if code == 0 and out:
        first = out.split("\n")[0].split()[-1]
        return "OK", f"SCX aktif: {os.path.basename(first)}"
    return "INFO", "Default kernel scheduler (EEVDF) - jalankan 'kalacakra scx lavd' bila perlu"

def check_layered_packages():
    """Jumlah paket layering rpm-ostree - terlalu banyak = menyimpang dari image atomik."""
    out, code = run_cmd(["rpm-ostree", "status", "--json"])
    if code == 0 and out:
        try:
            import json
            data = json.loads(out)
            deployments = data.get("deployments", [])
            for d in deployments:
                pkgs = d.get("packages", []) or d.get("requested-packages", [])
                if pkgs:
                    if len(pkgs) > 20:
                        return "WARN", f"{len(pkgs)} paket di-layer (pertimbangkan rebase)"
                    return "OK", f"{len(pkgs)} paket di-layer"
            return "OK", "Host murni tanpa layering (atomic penuh)"
        except Exception:
            pass
    return "INFO", "rpm-ostree tidak tersedia"

# ==============================================================================
# Bagian B: Resource & Kesehatan Harian
# ==============================================================================

def check_btrfs():
    out, code = run_cmd(["btrfs", "filesystem", "df", "/"])
    if code == 0:
        return "OK", out.split("\n")[0]
    return "WARN", "Btrfs tools not active or not Btrfs root"

def check_zram():
    out, code = run_cmd(["zramctl"])
    if code == 0 and "zram0" in out:
        return "OK", "Active (zstd compressed)"
    return "INFO", "Standard swap or inactive"

def check_ai_service():
    out, code = run_cmd(["systemctl", "--user", "is-active", "kalacakra-ai.service"])
    if out == "active":
        return "OK", "Running (Ollama @ 127.0.0.1:11434)"
    return "INFO", "Disabled / Standby"

def check_containers():
    out, code = run_cmd(["podman", "images", "-f", "dangling=true", "-q"])
    if code == 0:
        count = len([x for x in out.split("\n") if x])
        if count > 0:
            return "CLEANABLE", f"{count} dangling container images"
        return "OK", "0 dangling images"
    return "INFO", "Podman daemon not in use"

def check_flatpak_unused():
    out, code = run_cmd(["flatpak", "list", "--unused"])
    if code == 0 and out:
        count = len(out.split("\n"))
        return "CLEANABLE", f"{count} unused Flatpak runtimes"
    return "OK", "No unused runtimes"

def check_battery():
    for bat in ["/sys/class/power_supply/BAT0", "/sys/class/power_supply/BAT1"]:
        limit_file = os.path.join(bat, "charge_control_limit_max")
        if os.path.isfile(limit_file):
            try:
                with open(limit_file, "r") as f:
                    val = f.read().strip()
                return "OK", f"Cap active at {val}%"
            except Exception:
                pass
    return "INFO", "Default 100% or desktop PC without battery"

# ==============================================================================

def generate_html_report(out_path: str, core_results: list, daily_results: list, strings: dict):
    """Menghasilkan dashboard Glass Cockpit mandiri (zero-CDN) bernuansa Cyber-Kraton."""
    import datetime
    import platform

    total_checks = len(core_results) + len(daily_results)
    ok_count = sum(1 for status, _, _ in core_results + daily_results if status == "OK")
    warn_count = sum(1 for status, _, _ in core_results + daily_results if status in ("WARN", "CLEANABLE"))
    info_count = sum(1 for status, _, _ in core_results + daily_results if status == "INFO")
    
    score_pct = int((ok_count / total_checks) * 100) if total_checks else 100
    timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    uname = platform.uname()

    # Deteksi tema aktif
    data_home = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
    active_theme = "mandala-cyberpunk"
    active_path = os.path.join(data_home, "kalacakra", "look", "active.json")
    if os.path.isfile(active_path):
        try:
            import json
            with open(active_path, "r", encoding="utf-8") as f:
                active_theme = json.load(f).get("id", active_theme)
        except Exception:
            pass

    def badge_class(st):
        if st == "OK":
            return "badge-ok"
        elif st in ("WARN", "CLEANABLE"):
            return "badge-warn"
        return "badge-info"

    def render_rows(results):
        html_rows = []
