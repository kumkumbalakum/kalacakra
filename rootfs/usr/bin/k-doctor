        radial-gradient(circle at 85% 80%, rgba(0, 240, 255, 0.07) 0%, transparent 40%),
        radial-gradient(circle at 50% 50%, rgba(13, 17, 28, 0.95) 0%, #06080d 100%);
      color: var(--text-main);
