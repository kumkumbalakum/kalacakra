"""
    try:
        out_dir = os.path.dirname(os.path.abspath(out_path))
        if out_dir:
            os.makedirs(out_dir, exist_ok=True)
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(html_content)
        print(f"[k-doctor Glass Cockpit] Laporan HTML berhasil dibuat: {out_path}")
    except Exception as e:
        print(f"[k-doctor Error] Gagal menulis laporan HTML: {e}")

def print_row(strings, status, key, default_label, msg, width=26):
    label = strings.get(key, default_label)
    print(f"[{status:^6}] {label:<{width}} : {msg}")

def main():
    strings, lang = get_locale_strings()
    clean_mode = "--clean" in sys.argv

    html_target = None
    if "--html" in sys.argv:
        idx = sys.argv.index("--html")
        if idx + 1 < len(sys.argv) and not sys.argv[idx + 1].startswith("-"):
            html_target = sys.argv[idx + 1]
        else:
            html_target = "kalacakra-report.html"

    print()
    print("=" * 65)
    print(strings.get("doctor_header", "=== Kalacakra OS System Health Doctor ==="))
    print("=" * 65)
    print(strings.get("doctor_checking_all", "Menjalankan diagnosa integritas sistem..."))
    print("-" * 65)

    print(strings.get("doctor_section_core", "--- Jantung OS Imutabel / Immutable Core ---"))
    checks_core = [
        (check_bootc_status,      "doctor_label_bootc",      "Image Bootable (bootc)"),
        (check_rollback_protection, "doctor_label_rollback", "Proteksi Rollback Boot"),
        (check_selinux,           "doctor_label_selinux",    "Keamanan SELinux"),
        (check_dot_dns,           "doctor_label_dot",        "DNS-over-TLS Resolver"),
        (check_firewall,          "doctor_label_firewall",   "Firewall (firewalld)"),
        (check_usbguard,          "doctor_label_usbguard",   "USBGuard Device Policy"),
        (check_tailscale,         "doctor_label_tailscale",  "Tailscale Mesh"),
        (check_scheduler,         "doctor_label_scheduler",  "CPU Scheduler (SCX)"),
        (check_layered_packages,  "doctor_label_layering",   "Paket Layering (ostree)"),
    ]
    core_results = []
    for func, key, default in checks_core:
        status, msg = func()
        label = strings.get(key, default)
        core_results.append((status, label, msg))
        print_row(strings, status, key, default, msg)

    print("-" * 65)
    print(strings.get("doctor_section_resource", "--- Resource & Kesehatan Harian / Daily Resources ---"))

    checks_daily = [
        (check_btrfs,             "doctor_label_btrfs",      "Filesystem Root (Btrfs)"),
        (check_zram,              "doctor_label_zram",       "ZRAM Swap Engine"),
        (check_ai_service,        "doctor_label_ai",         "Local AI Daemon (k-ai)"),
        (check_containers,        "doctor_label_containers", "Container Storage"),
        (check_flatpak_unused,    "doctor_label_flatpak",    "Flatpak Runtimes"),
        (check_battery,           "doctor_label_battery",    "Battery Preservation"),
    ]
    status_cont = status_fp = "OK"
    daily_results = []
    for func, key, default in checks_daily:
        status, msg = func()
        label = strings.get(key, default)
        daily_results.append((status, label, msg))
        if func is check_containers:
            status_cont = status
        elif func is check_flatpak_unused:
            status_fp = status
        print_row(strings, status, key, default, msg)

    print("-" * 65)

    if html_target:
        generate_html_report(html_target, core_results, daily_results, strings)

    if clean_mode or (status_cont == "CLEANABLE" or status_fp == "CLEANABLE"):
        if not clean_mode:
            prompt = strings.get("doctor_clean_prompt", "Bersihkan file usang sekarang? [Y/n]: ")
            try:
                ans = input(prompt).strip().lower()
            except (KeyboardInterrupt, EOFError):
                ans = "n"
        else:
            ans = "y"

        if ans in ("", "y", "yes"):
            print(strings.get("doctor_clean_cache", "Cleaning unused Flatpak runtimes & user cache..."))
            for cleanup_cmd in (["flatpak", "uninstall", "--unused", "-y"],
                                ["podman", "system", "prune", "-f"]):
                try:
                    subprocess.run(cleanup_cmd, check=False)
                except FileNotFoundError:
                    tool = cleanup_cmd[0]
                    print(f"[INFO] {tool} tidak tersedia - dilewati.")
            print("[OK] Pembersihan selesai! / Cleanup complete!")
    else:
        print(strings.get("doctor_all_healthy", "All systems are healthy and operating optimally!"))
    print()

if __name__ == "__main__":
    main()

