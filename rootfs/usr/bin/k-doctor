            <div class="probe-card">
              <div class="probe-header">
                <span class="probe-title">{label}</span>
                <span class="badge {cls}">{st}</span>
              </div>
              <div class="probe-msg">{msg}</div>
            </div>
            """)
        return "\n".join(html_rows)

    core_cards = render_rows(core_results)
    daily_cards = render_rows(daily_results)

    html_content = f"""<!DOCTYPE html>
<html lang="id">
