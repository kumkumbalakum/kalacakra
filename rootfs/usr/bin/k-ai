#!/usr/bin/env python3
"""
Kalacakra OS - k-ai Terminal Companion & Error Diagnostic
Natural Language to Bash translator, stderr analyzer, with Secret Redaction & Safety Gate.
Supports English & Bahasa Indonesia out-of-the-box.
"""

import os
import sys
import re
import json
import urllib.request
import urllib.error
import subprocess
import argparse

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
LIB_PATH = os.path.abspath(os.path.join(SCRIPT_DIR, "..", "share", "kalacakra", "lib"))
if os.path.isdir(LIB_PATH) and LIB_PATH not in sys.path:
    sys.path.insert(0, LIB_PATH)
elif "/usr/share/kalacakra/lib" not in sys.path and os.path.isdir("/usr/share/kalacakra/lib"):
    sys.path.insert(0, "/usr/share/kalacakra/lib")

try:
    from kalacakra_common import get_locale_strings, redact_secrets, is_dangerous_command
except ImportError:
    def get_locale_strings(lang_override=None):
        return {}, "en"
    def redact_secrets(t):
        return t, False
    def is_dangerous_command(c):
        return False

DEFAULT_OLLAMA_URL = os.environ.get("OLLAMA_URL", "http://127.0.0.1:11434/api/generate")
DEFAULT_MODEL = os.environ.get("KALACAKRA_AI_MODEL", "llama3.2:1b")

def call_ollama(prompt: str, system_prompt: str, model: str = DEFAULT_MODEL) -> str:
    payload = {
        "model": model,
        "prompt": prompt,
        "system": system_prompt,
        "stream": False
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        DEFAULT_OLLAMA_URL,
        data=data,
        headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            result = json.loads(resp.read().decode("utf-8"))
            return result.get("response", "").strip()
    except urllib.error.URLError as e:
        return f"ERROR: Tidak dapat terhubung ke Ollama daemon (localhost:11434). Pastikan 'systemctl --user start kalacakra-ai' aktif. Detail: {e}"

def clean_code_block(text: str) -> str:
    match = re.search(r"```(?:bash|sh)?\n?(.*?)\n?```", text, re.DOTALL)
    if match:
        return match.group(1).strip()
    return text.strip()

def validate_bash_syntax(cmd: str) -> tuple[bool, str]:
    """Menjalankan bash -n untuk memvalidasi sintaks sebelum eksekusi."""
    res = subprocess.run(["bash", "-n", "-c", cmd], capture_output=True, text=True, check=False)
    if res.returncode == 0:
        return True, ""
    return False, res.stderr.strip()

def main():
    parser = argparse.ArgumentParser(
        prog="k-ai",
        description="Kalacakra OS Terminal Companion & Diagnostic (EN/ID)"
    )
    parser.add_argument("query", nargs="*", help="Natural language request or error text")
    parser.add_argument("--diagnose", "-d", action="store_true", help="Diagnose last terminal error")
    parser.add_argument("--yes", "-y", action="store_true", help="Skip safety prompt")
    parser.add_argument("--model", "-m", default=DEFAULT_MODEL, help="Target Ollama model")

    args = parser.parse_args()
    strings, current_lang = get_locale_strings()

    raw_query = " ".join(args.query)

    if not sys.stdin.isatty():
        stdin_content = sys.stdin.read().strip()
        if stdin_content:
            raw_query = f"{raw_query}\n{stdin_content}".strip()
            args.diagnose = True

    if not raw_query:
        print("[k-ai] Silakan masukkan pertanyaan atau perintah bahasa alami / Please enter a prompt.")
        print("Contoh: k-ai 'cari file video yang lebih dari 500mb'")
        print("Example: k-ai 'find video files larger than 500MB'")
        sys.exit(0)

    # 1. Secret Sanitization Guardrail
    sanitized_query, had_secrets = redact_secrets(raw_query)
    if had_secrets:
        print(strings.get("ai_secret_redacted", "[k-ai Shield] Sensitive secrets detected and automatically redacted."))

    # 2. System prompt bilingual
    if args.diagnose:
        system_prompt = (
            "You are a Linux system diagnostic expert on Kalacakra OS (Fedora bootc / KDE Plasma 6). "
            "Analyze the given error and provide a concise diagnosis and the exact command to fix it. "
            "Reply in the same language as the user (Indonesian or English). "
            "Include the command inside a ```bash ... ``` code block."
        )
    else:
        system_prompt = (
            "You are a terminal command generator for Kalacakra OS (Linux, modern bash). "
            "Convert the user's natural language request into a single, correct, and safe Bash command. "
            "OUTPUT ONLY the Bash command inside a ```bash ... ``` code block without conversational filler."
        )

    print(f"[k-ai] Berpikir / Thinking using '{args.model}'...")
    response = call_ollama(sanitized_query, system_prompt, model=args.model)

    if response.startswith("ERROR:"):
        print(response)
        sys.exit(1)

    suggested_cmd = clean_code_block(response)

    if args.diagnose:
        print("\n=== [k-ai Diagnostik] ===")
        print(response)
        print()
    else:
        print()
        # Periksa apakah perintah berisiko destruktif
        is_dangerous = is_dangerous_command(suggested_cmd)
        if is_dangerous:
            print("!" * 70)
            print(strings.get("ai_dangerous_warning", "[PERINGATAN BAHAYA] Perintah ini terdeteksi berpotensi merusak sistem!"))
            print("!" * 70)

        print(strings.get("ai_safety_warning", "[k-ai Guard] Perintah berikut akan dieksekusi:"))
        print(f"\n  $ {suggested_cmd}\n")

        if args.yes and not is_dangerous:
            action = "y"
        else:
            prompt_confirm = strings.get("ai_safety_confirm", "Jalankan perintah ini? [Y/n/e] (e=edit): ")
            try:
                action = input(prompt_confirm).strip().lower()
            except (KeyboardInterrupt, EOFError):
                action = "n"

        if action == "e":
            edit_prompt = strings.get("ai_edit_prompt", "Ketik perintah yang dimodifikasi: ")
            try:
                suggested_cmd = input(f"{edit_prompt}").strip()
                action = "y"
            except (KeyboardInterrupt, EOFError):
                action = "n"

        if action in ("", "y", "yes"):
            # Validasi sintaks bash
            valid_syntax, err_msg = validate_bash_syntax(suggested_cmd)
            if not valid_syntax:
                print(f"[k-ai Error] Sintaks perintah tidak valid: {err_msg}")
                sys.exit(1)

            print("[k-ai] Menjalankan perintah...")
            subprocess.run(["bash", "-c", suggested_cmd])
        else:
            print(strings.get("ai_aborted", "Eksekusi dibatalkan."))

if __name__ == "__main__":
    main()
