#!/usr/bin/env python3
"""
Kalacakra OS - k-ai Terminal Companion & Error Diagnostic
Natural Language to Bash translator, stderr analyzer, with Secret Redaction & Safety Gate.
Supports English & Bahasa Indonesia out-of-the-box.
"""

import os
import sys
import re
import json
import urllib.request
import urllib.error
import subprocess
import argparse

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Path library bersama ditangani oleh _kalacakra_bootstrap.

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import get_locale_strings, redact_secrets, is_dangerous_command

DEFAULT_OLLAMA_URL = os.environ.get("OLLAMA_URL", "http://127.0.0.1:11434/api/generate")
DEFAULT_MODEL = os.environ.get("KALACAKRA_AI_MODEL", "llama3.2:1b")

# Direktori sensitif yang ditolak k-ai baca isinya (kebijakan privasi/keamanan).
PROTECTED_DIRS = [
    os.path.expanduser("~/.ssh"),
    os.path.expanduser("~/.gnupg"),
    os.path.expanduser("~/.aws"),
    os.path.expanduser("~/.config/sops"),
]


def is_protected_path(path: str) -> bool:
    ap = os.path.abspath(os.path.expanduser(path))
    for pref in PROTECTED_DIRS:
        if ap == pref or ap.startswith(pref + os.sep):
            return True
    base = os.path.basename(ap)
    if base in (".env", ".netrc", "credentials", "id_rsa", "id_ed25519"):
        return True
    return False


def read_text_file(path: str, max_bytes: int = 20000) -> tuple[str, str]:
    """Baca berkas teks dengan batas aman. Mengembalikan (isi, pesan_error).
    Jujur: biner dideteksi & ditolak; berkas besar dipotong dengan penanda;
    jalur sensitif (~/.ssh, ~/.gnupg, ~/.aws, .env, ...) DITOLAK."""
    if is_protected_path(path):
        return "", (f"'{path}' berada di area terproteksi (rahasia) - "
                    f"isi tidak dibaca/dikirim ke AI sesuai kebijakan privasi.")
    if not os.path.isfile(path):
        return "", f"berkas tidak ditemukan: {path}"
    try:
        with open(path, "rb") as f:
            raw = f.read(max_bytes + 1)
    except OSError as e:
        return "", f"gagal membaca '{path}': {e}"
    if b"\x00" in raw:
        return "", f"'{path}' tampaknya berkas biner (bukan teks) - dilewati."
    truncated = len(raw) > max_bytes
    text = raw[:max_bytes].decode("utf-8", errors="replace")
    if truncated:
        text += f"\n\n[... dipotong pada {max_bytes} byte ...]"
    return text, ""


def _ollama_timeout() -> float:
    """Timeout dapat dikonfigurasi via env (detik). Default 120s agar model
    besar / mesin lambat tidak putus di tengah. Set 0 = tanpa batas."""
    raw = os.environ.get("KALACAKRA_AI_TIMEOUT", "120")
    try:
        val = float(raw)
    except ValueError:
        return 120.0
    return None if val <= 0 else val

def call_ollama(prompt: str, system_prompt: str, model: str = DEFAULT_MODEL,
                stream: bool = False) -> str:
    """Panggil Ollama. Jika stream=True, tampilkan token secara bertahap
    (NDJSON) dan kembalikan teks lengkap; jika urllib gagal, kembalikan
    string berawalan 'ERROR:'."""
    payload = {
        "model": model,
        "prompt": prompt,
        "system": system_prompt,
        "stream": bool(stream)
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        DEFAULT_OLLAMA_URL,
        data=data,
        headers={"Content-Type": "application/json"}
    )
    timeout = _ollama_timeout()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if not stream:
                result = json.loads(resp.read().decode("utf-8"))
                return result.get("response", "").strip()

            # Mode streaming: Ollama mengirim NDJSON (satu objek JSON per baris).
            chunks = []
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                piece = obj.get("response", "")
                if piece:
                    chunks.append(piece)
                    sys.stdout.write(piece)
                    sys.stdout.flush()
                if obj.get("done"):
                    break
            sys.stdout.write("\n")
            return "".join(chunks).strip()
    except urllib.error.URLError as e:
        return f"ERROR: Tidak dapat terhubung ke Ollama daemon (localhost:11434). Pastikan 'systemctl --user start kalacakra-ai' aktif. Detail: {e}"
    except OSError as e:
        return (f"ERROR: Koneksi ke Ollama gagal / timeout setelah {timeout}s "
                f"(naikkan via KALACAKRA_AI_TIMEOUT). Detail: {e}")

def clean_code_block(text: str) -> str:
    match = re.search(r"```(?:bash|sh)?\n?(.*?)\n?```", text, re.DOTALL)
    if match:
        return match.group(1).strip()
    return text.strip()

def validate_bash_syntax(cmd: str) -> tuple[bool, str]:
    """Menjalankan bash -n untuk memvalidasi sintaks sebelum eksekusi."""
    res = subprocess.run(["bash", "-n", "-c", cmd], capture_output=True, text=True, check=False)
    if res.returncode == 0:
        return True, ""
    return False, res.stderr.strip()

def main():
    parser = argparse.ArgumentParser(
        prog="k-ai",
        description="Kalacakra OS Terminal Companion & Diagnostic (EN/ID)"
    )
    parser.add_argument("query", nargs="*", help="Natural language request or error text")
    parser.add_argument("--diagnose", "-d", action="store_true", help="Diagnose last terminal error")
    parser.add_argument("--yes", "-y", action="store_true", help="Skip safety prompt")
    parser.add_argument("--model", "-m", default=DEFAULT_MODEL, help="Target Ollama model")
    parser.add_argument("--stream", "-s", action="store_true",
                        help="Tampilkan jawaban token demi token (NDJSON streaming)")
    parser.add_argument("--file", "-f", help="Ringkas/analisis berkas teks (untuk integrasi Dolphin)")
    parser.add_argument("--max-bytes", type=int, default=20000,
                        help="Batas byte berkas yang dibaca untuk --file (default 20000)")

    args = parser.parse_args()
    strings, current_lang = get_locale_strings()

    raw_query = " ".join(args.query)

    # Mode --file: baca berkas (dibatasi), lalu mode "ringkas/analisis".
    if args.file:
        file_text, file_err = read_text_file(args.file, args.max_bytes)
        if file_err:
            print(f"[k-ai Error] {file_err}")
            sys.exit(1)
        pre = raw_query or ("Ringkas berkas ini dan sebutkan poin-poin pentingnya."
                            if current_lang == "id" else
                            "Summarize this file and list the key points.")
        raw_query = f"{pre}\n\n=== ISI BERKAS: {os.path.basename(args.file)} ===\n{file_text}"

    if not sys.stdin.isatty():
        stdin_content = sys.stdin.read().strip()
        if stdin_content:
            raw_query = f"{raw_query}\n{stdin_content}".strip()
            args.diagnose = True

    if not raw_query:
        print("[k-ai] Silakan masukkan pertanyaan atau perintah bahasa alami / Please enter a prompt.")
        print("Contoh: k-ai 'cari file video yang lebih dari 500mb'")
        print("Example: k-ai 'find video files larger than 500MB'")
        sys.exit(0)

    # 1. Secret Sanitization Guardrail
    sanitized_query, had_secrets = redact_secrets(raw_query)
    if had_secrets:
        print(strings.get("ai_secret_redacted", "[k-ai Shield] Sensitive secrets detected and automatically redacted."))

    # 2. System prompt bilingual
    if args.file:
        system_prompt = (
            "You are a helpful assistant on Kalacakra OS. Summarize the provided file clearly in the "
            "same language as the user's request. State the file's purpose, key points, and any "
            "actionable items. Be concise. Do NOT execute anything."
        )
    elif args.diagnose:
        system_prompt = (
            "You are a Linux system diagnostic expert on Kalacakra OS (Fedora bootc / KDE Plasma 6). "
            "Analyze the given error and provide a concise diagnosis and the exact command to fix it. "
            "Reply in the same language as the user (Indonesian or English). "
            "Include the command inside a ```bash ... ``` code block."
        )
    else:
        system_prompt = (
            "You are a terminal command generator for Kalacakra OS (Linux, modern bash). "
            "Convert the user's natural language request into a single, correct, and safe Bash command. "
            "OUTPUT ONLY the Bash command inside a ```bash ... ``` code block without conversational filler."
        )

    print(f"[k-ai] Berpikir / Thinking using '{args.model}'...")
    response = call_ollama(sanitized_query, system_prompt, model=args.model, stream=args.stream)

    if response.startswith("ERROR:"):
        print(response)
        sys.exit(1)

    suggested_cmd = clean_code_block(response)

    if args.file:
        # Mode ringkas berkas: hanya tampilkan jawaban, tanpa eksekusi/konfirmasi.
        print("\n=== [k-ai Ringkasan Berkas] ===" if current_lang == "id" else "\n=== [k-ai File Summary] ===")
        print(response)
        print()
    elif args.diagnose:
        print("\n=== [k-ai Diagnostik] ===")
        print(response)
        print()
    else:
        print()
        # Periksa apakah perintah berisiko destruktif
        is_dangerous = is_dangerous_command(suggested_cmd)
        if is_dangerous:
            print("!" * 70)
            print(strings.get("ai_dangerous_warning", "[PERINGATAN BAHAYA] Perintah ini terdeteksi berpotensi merusak sistem!"))
            print("!" * 70)

        print(strings.get("ai_safety_warning", "[k-ai Guard] Perintah berikut akan dieksekusi:"))
        print(f"\n  $ {suggested_cmd}\n")

        if args.yes and not is_dangerous:
            action = "y"
        else:
            prompt_confirm = strings.get("ai_safety_confirm", "Jalankan perintah ini? [Y/n/e] (e=edit): ")
            try:
                action = input(prompt_confirm).strip().lower()
            except (KeyboardInterrupt, EOFError):
                action = "n"

        if action == "e":
            edit_prompt = strings.get("ai_edit_prompt", "Ketik perintah yang dimodifikasi: ")
            try:
                suggested_cmd = input(f"{edit_prompt}").strip()
                action = "y"
            except (KeyboardInterrupt, EOFError):
                action = "n"

        if action in ("", "y", "yes"):
            # Validasi sintaks bash
            valid_syntax, err_msg = validate_bash_syntax(suggested_cmd)
            if not valid_syntax:
                print(f"[k-ai Error] Sintaks perintah tidak valid: {err_msg}")
                sys.exit(1)

            print("[k-ai] Menjalankan perintah...")
            subprocess.run(["bash", "-c", suggested_cmd])
        else:
            print(strings.get("ai_aborted", "Eksekusi dibatalkan."))

if __name__ == "__main__":
    main()
