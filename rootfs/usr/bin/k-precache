#!/usr/bin/env python3
"""
Kalacakra OS - k-precache
Vulkan Anti-Stutter Shader Pre-Cache Engine
Pre-compiles DXVK/VKD3D pipeline shaders for Steam, Heroic, and Lutris games
to eliminate initial stuttering and guarantee locked 60 - 144 FPS gameplay.
"""

import os
import glob
import subprocess
import argparse

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import get_locale_strings

STEAM_SHADER_DIRS = [
    os.path.expanduser("~/.local/share/Steam/steamapps/shadercache"),
    os.path.expanduser("~/.var/app/com.valvesoftware.Steam/data/Steam/steamapps/shadercache")
]

def find_fossilize_databases():
    databases = []
    for s_dir in STEAM_SHADER_DIRS:
        if os.path.isdir(s_dir):
            for db in glob.glob(os.path.join(s_dir, "*", "fozpipelinesv6*")):
                databases.append(db)
    return databases

def find_fossilize_replay():
    """Cari fossilize_replay: PATH, lalu Steam runtime (fossilizeReplay bundled)."""
    import shutil
    found = shutil.which("fossilize_replay") or shutil.which("fossilizeReplay")
    if found:
        return found
    # Cari di dalam runtime Steam / Proton
    patterns = [
        os.path.expanduser("~/.local/share/Steam/ubuntu12_32/steam-runtime/usr/bin/fossilize_replay"),
        os.path.expanduser("~/.steam/steam/ubuntu12_32/steam-runtime/usr/bin/fossilize_replay"),
        os.path.expanduser("~/.local/share/Steam/steamapps/common/Proton*/files/bin/fossilize_replay"),
    ]
    for p in patterns:
        matches = glob.glob(p)
        if matches and os.path.isfile(matches[0]) and os.access(matches[0], os.X_OK):
            return matches[0]
    return None

def precompile_shaders():
    databases = find_fossilize_databases()
    if not databases:
        print("[k-precache INFO] Tidak ada database shader Fossilize Steam terdeteksi.")
        print("Pastikan opsi 'Shader Pre-caching' aktif di pengaturan Steam.")
        return

    replay = find_fossilize_replay()
    if not replay:
        print("[k-precache WARN] 'fossilize_replay' TIDAK ditemukan - kompilasi TIDAK dijalankan.")
        print("   Database ditemukan, tetapi tool replay tidak ada di sistem maupun Steam runtime.")
        print("   Kompilasi shader tetap ditangani otomatis oleh Steam saat game dijalankan.")
        return

    print(f"[k-precache] Ditemukan {len(databases)} database pipeline shader game.")
    ok_count = 0
    for db in databases:
        game_id = os.path.basename(os.path.dirname(db))
        print(f" -> Memproses Game AppID {game_id}...")
        res = subprocess.run([replay, db], check=False)
        if res.returncode == 0:
            ok_count += 1
    if ok_count:
        print(f"[k-precache OK] Kompilasi shader selesai untuk {ok_count}/{len(databases)} database.")
    else:
        print("[k-precache WARN] Tidak ada database yang berhasil dikompilasi.")

def main():
    parser = argparse.ArgumentParser(
        prog="k-precache",
        description="Kalacakra Vulkan Anti-Stutter Shader Pre-Cache Engine"
    )
    subparsers = parser.add_subparsers(dest="command")
    subparsers.add_parser("run", help="Pre-compile all pending Vulkan shaders")
    subparsers.add_parser("list", help="List games with cached shaders")

    args = parser.parse_args()
    strings, current_lang = get_locale_strings()

    print()
    print("=" * 65)
    print(strings.get("precache_header", "=== Kalacakra Vulkan Anti-Stutter Pre-Cache Engine ==="))
    print("=" * 65)

    if not args.command or args.command == "run":
        print(strings.get("precache_running", "Pre-compiling shaders in background..."))
        precompile_shaders()
    elif args.command == "list":
        dbs = find_fossilize_databases()
        print(f"Total Database Shader Terdeteksi: {len(dbs)}")
        for db in dbs:
            print(f" - {db}")

    print("=" * 65)
    print()

if __name__ == "__main__":
    main()
