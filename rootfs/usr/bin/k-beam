#!/usr/bin/env python3
"""
Kalacakra OS - k-beam
AirDrop-like Zero-Config P2P Local Mesh File Transfer
Sends and receives files between Linux, Android, iOS, Windows, and Mac over local Wi-Fi without internet.
"""

import os
import sys
import shutil
import socket
import http.server
import socketserver
import urllib.parse
import urllib.request
import secrets
import argparse
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Path library bersama ditangani oleh _kalacakra_bootstrap.

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import get_locale_strings

def get_local_ip() -> str:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(('10.255.255.255', 1))
        IP = s.getsockname()[0]
    except Exception:
        IP = '127.0.0.1'
    finally:
        s.close()
    return IP

def start_beam_receiver(port: int = 53317, save_dir: str = None, token: str = None):
    if not save_dir:
        save_dir = os.path.expanduser("~/Downloads/Beam")
    save_dir = os.path.abspath(save_dir)
    os.makedirs(save_dir, exist_ok=True)

    if not token:
        token = secrets.token_urlsafe(16)

    ip = get_local_ip()
    print("=" * 60)
    print("=== [Kalacakra Beam] Receiver Server Active ===")
    print("=" * 60)
    print(f"IP Lokal          : http://{ip}:{port}")
    print(f"Akses Token       : {token}")
    print(f"Direktori Simpan  : {save_dir}")
    print("-" * 60)
    print("Buka browser di HP/Tablet/PC lain pada Wi-Fi yang sama:")
    print(f" -> http://{ip}:{port}/?token={token}")
    print("Tekan Ctrl+C untuk menghentikan server.")
    print("=" * 60)

    class BeamUploadHandler(http.server.SimpleHTTPRequestHandler):
        # Nonaktifkan directory listing demi keamanan (file hanya lewat upload)
        def list_directory(self, path):
            self.send_error(403, "Directory listing disabled")
            return None

        def _check_token(self) -> bool:
            parsed = urllib.parse.urlparse(self.path)
            q = urllib.parse.parse_qs(parsed.query)
            supplied = q.get("token", [""])[0]
            return supplied == token and len(token) >= 8

        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=save_dir, **kwargs)

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path == "/":
                if not self._check_token():
                    self.send_response(403)
                    self.send_header("Content-Type", "text/html; charset=utf-8")
                    self.end_headers()
                    self.wfile.write(b"<h2>403 - Token tidak valid. Buka link dari layar laptop penerima.</h2>")
                    return
                html = f"""<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kalacakra Beam - Transfer File</title>
    <style>
        body {{ font-family: sans-serif; background: #1a1b26; color: #c0caf5; text-align: center; padding: 30px; }}
        .card {{ background: #24283b; padding: 25px; border-radius: 12px; max-width: 450px; margin: auto; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }}
        input, button {{ margin: 15px 0; padding: 12px; border-radius: 8px; width: 85%; font-size: 16px; }}
        button {{ background: #bb9af7; color: #1a1b26; font-weight: bold; border: none; cursor: pointer; }}
    </style>
</head>
<body>
    <div class="card">
        <h2>☸️ Kalacakra Beam</h2>
        <p>Kirim file langsung ke laptop ini secara instan:</p>
        <form method="POST" enctype="multipart/form-data" action="/upload?token={token}">
            <input type="file" name="file" required><br>
            <button type="submit">Kirim File / Send File</button>
        </form>
    </div>
</body>
</html>"""
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                self.wfile.write(html.encode("utf-8"))
            else:
                # Cegah directory listing / akses file sembarang tanpa token
                if self._check_token():
                    super().do_GET()
                else:
                    self.send_error(403, "Invalid or missing token")
                    return

        def do_POST(self):
            if self.path.startswith("/upload"):
                if not self._check_token():
                    self.send_error(403, "Invalid or missing token")
                    return
                content_type = self.headers.get("Content-Type", "")
                if "multipart/form-data" not in content_type:
                    self.send_error(400, "Expected multipart/form-data")
                    return

                try:
                    length = int(self.headers.get('content-length', 0))
                except ValueError:
                    length = 0

                # Batasi ukuran body untuk mencegah DoS memori (file besar sebaiknya
                # dikirim lewat kanal lain). Dapat disetel ulang via env.
                max_upload = int(os.environ.get("KALACAKRA_BEAM_MAX_BYTES", str(2 * 1024 * 1024 * 1024)))
                if length <= 0:
                    self.send_error(411, "Length Required")
                    return
                if length > max_upload:
                    self.send_error(413, f"Payload too large (limit {max_upload} bytes)")
                    return

                data = self.rfile.read(length)
                saved, rejected = self._save_multipart(data, content_type)

                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                summary = f"{len(saved)} file tersimpan"
                if rejected:
                    summary += f", {len(rejected)} ditolak"
                self.wfile.write(
                    f"<h2>File Berhasil Dikirim! / File Received Successfully! ({summary})</h2>"
                    f"<a href='/'>Kembali</a>".encode("utf-8")
                )
                return
            self.send_response(400)
            self.end_headers()

        def _save_multipart(self, data: bytes, content_type: str):
            """Parse multipart secara benar & aman, simpan tiap file ke save_dir.
            Mengembalikan (list_nama_tersimpan, list_nama_ditolak)."""
            import email
            saved, rejected = [], []

            # Bangun pesan MIME lengkap agar email.parser menangani boundary,
            # header filename, dan encoding dengan benar (bukan split manual).
            header = f"Content-Type: {content_type}\r\nMIME-Version: 1.0\r\n\r\n".encode("utf-8")
            msg = email.message_from_bytes(header + data)

            if not msg.is_multipart():
                return saved, rejected

            for part in msg.walk():
                if part.get_content_maintype() == "multipart":
                    continue
                filename = part.get_filename()
                if not filename:
                    continue
                payload = part.get_payload(decode=True)
                if payload is None:
                    continue

                # Pertahanan path traversal: hanya basename, tolak path direktori
                safe_name = os.path.basename(filename.replace("\\", "/"))
                if not safe_name or safe_name in (".", ".."):
                    rejected.append(filename)
                    print(f"[Kalacakra Beam] DITOLAK (nama tak valid): {filename!r}")
                    continue

                out_path = os.path.abspath(os.path.join(save_dir, safe_name))
                # Double-check: hasil join wajib masih di dalam save_dir
                if not out_path.startswith(save_dir + os.sep):
                    rejected.append(safe_name)
                    print(f"[Kalacakra Beam] DITOLAK (path traversal): {safe_name}")
                    continue

                try:
                    with open(out_path, "wb") as f:
                        f.write(payload)
                except OSError as e:
                    rejected.append(safe_name)
                    print(f"[Kalacakra Beam] GAGAL menulis {safe_name}: {e}")
                    continue

                saved.append(safe_name)
                print(f"[Kalacakra Beam] File diterima: {safe_name} ({len(payload)} bytes)")

            return saved, rejected

    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("", port), BeamUploadHandler) as httpd:
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\n[k-beam] Server dihentikan.")

def main():
    parser = argparse.ArgumentParser(
        prog="k-beam",
        description="Kalacakra Beam - P2P Mesh File Transfer"
    )
    subparsers = parser.add_subparsers(dest="command")

    p_send = subparsers.add_parser("send", help="Send file to another device")
    p_send.add_argument("file", help="File to send")
    p_send.add_argument("target", nargs="?", help="Target IP address")

    p_recv = subparsers.add_parser("receive", help="Start Beam receiver server")
    p_recv.add_argument("--port", type=int, default=53317, help="Port to listen on (default 53317)")

    args = parser.parse_args()
    strings, current_lang = get_locale_strings()

    if not args.command or args.command == "receive":
        start_beam_receiver(port=getattr(args, "port", 53317))
    elif args.command == "send":
        if not os.path.exists(args.file):
            print(f"[k-beam Error] Berkas '{args.file}' tidak ditemukan.")
            sys.exit(1)
        print(strings.get("beam_sending", "Sending '{file}'...").format(file=args.file))
        # 1. Jika LocalSend terpasang, panggil localsend
        if shutil.which("localsend"):
            subprocess.run(["localsend", args.file])
            sys.exit(0)
        # 2. Jika target IP diberikan, unggah langsung ke receiver Beam target
        if args.target:
            token = input("Token akses dari layar penerima: ").strip()
            url = f"http://{args.target}:53317/upload?token={urllib.parse.quote(token)}"
            boundary = "KalacakraBeamBoundary"
            fname = os.path.basename(args.file)
            with open(args.file, "rb") as fh:
                payload = fh.read()
            body = (
                f"--{boundary}\r\n"
                f'Content-Disposition: form-data; name="file"; filename="{fname}"\r\n'
                f"Content-Type: application/octet-stream\r\n\r\n"
            ).encode() + payload + f"\r\n--{boundary}--\r\n".encode()
            req = urllib.request.Request(
                url, data=body,
                headers={"Content-Type": f"multipart/form-data; boundary={boundary}"}
            )
            try:
                with urllib.request.urlopen(req, timeout=60) as resp:
                    print(f"[k-beam OK] Server membalas HTTP {resp.status} - file terkirim ke {args.target}.")
            except Exception as e:
                print(f"[k-beam Error] Gagal mengirim ke {args.target}: {e}")
                sys.exit(1)
            sys.exit(0)
        # 3. Fallback: beri instruksi (jangan jalankan server blocking)
        print("[k-beam] 'localsend' tidak terpasang dan target IP tidak diberikan.")
        print("[k-beam] Cara kirim ke perangkat lain:")
        print("   1. Di penerima jalankan: k-beam receive")
        print("   2. Di sini jalankan    : k-beam send <file> <ip_penerima>")
        sys.exit(1)

if __name__ == "__main__":
    main()
