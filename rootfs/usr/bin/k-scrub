#!/usr/bin/env python3
"""
Kalacakra OS - k-scrub (Btrfs Data Integrity & Bitrot Guard)
ZFS-style periodic scrubbing engine for Btrfs filesystems.
Verifies cryptographic checksums across all data blocks on SSD/NVMe drives,
detecting and repairing silent bitrot and hardware decay.
"""

import os
import sys
import shutil
import subprocess
import argparse

if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Path library bersama ditangani oleh _kalacakra_bootstrap.

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import get_locale_strings

TARGET_PATHS = ["/", "/home", "/var"]

def start_scrub(path: str = "/"):
    print(f"[Kalacakra Scrub] Memulai pemeriksaan integritas checksum Btrfs pada '{path}'...")
    if not shutil.which("btrfs"):
        print("[k-scrub Error] 'btrfs' (btrfs-progs) tidak terpasang - scrub TIDAK dijalankan.")
        sys.exit(1)
    # 'btrfs scrub start' berjalan di background secara default; scrub dimulai sebagai root
    res = subprocess.run(["btrfs", "scrub", "start", path], check=False)
    if res.returncode != 0:
        print(f"[k-scrub Error] 'btrfs scrub start' gagal (kode {res.returncode}) - mungkin butuh sudo.")
        sys.exit(res.returncode)
    print("[Kalacakra Scrub] Scrub berjalan di latar belakang (I/O ramah daya).")
    print("Gunakan 'k-scrub status' untuk memantau kemajuan verifikasi.")

def check_status(path: str = "/"):
    strings, current_lang = get_locale_strings()
    print()
    print("=" * 70)
    print("=== [Kalacakra Scrub] Status Integritas Blok Data (ZFS-Style) ===")
    print("=" * 70)
    print(f" Target Partisi  : {path}")

    has_real_btrfs = False
    if shutil.which("btrfs"):
        try:
            res = subprocess.run(["btrfs", "scrub", "status", path], capture_output=True, text=True, check=False)
            if res.returncode == 0:
                print("-" * 70)
                print(res.stdout.strip())
                has_real_btrfs = True
        except Exception:
            pass

    if not has_real_btrfs:
        print(" Status          : TIDAK DIKETAHUI")
        if not shutil.which("btrfs"):
            print(" Penyebab        : perintah 'btrfs' tidak terpasang di sistem ini.")
        else:
            print(" Penyebab        : 'btrfs scrub status' gagal - '{path}' mungkin bukan Btrfs.".format(path=path))
        print("                  Tidak ada data scrub untuk ditampilkan (tanpa nilai simulasi).")
        print(" Langkah         : pasang btrfs-progs & pastikan partisi root memakai Btrfs.")
    else:
        print(strings.get("scrub_healthy", "Integritas blok data Btrfs dalam kondisi prima (0 checksum error)!"))

    print("=" * 70)
    print()

def cancel_scrub(path: str = "/"):
    print(f"[Kalacakra Scrub] Membatalkan proses scrub pada '{path}'...")
    if not shutil.which("btrfs"):
        print("[k-scrub Error] 'btrfs' tidak terpasang - tidak ada proses scrub untuk dibatalkan.")
        sys.exit(1)
    res = subprocess.run(["btrfs", "scrub", "cancel", path], check=False)
    if res.returncode != 0:
        print(f"[k-scrub Error] Gagal membatalkan (kode {res.returncode}) - mungkin tidak ada scrub aktif.")
        sys.exit(res.returncode)
    print("[Kalacakra Scrub] Proses verifikasi dihentikan.")

def main():
    parser = argparse.ArgumentParser(
        prog="k-scrub",
        description="Kalacakra Scrub - ZFS-style Btrfs Data Integrity & Bitrot Guard"
    )
    subparsers = parser.add_subparsers(dest="command")

    p_st = subparsers.add_parser("start", help="Start background Btrfs data integrity scrub")
    p_st.add_argument("path", nargs="?", default="/", help="Mount point or subvolume path (default: /)")

    p_stat = subparsers.add_parser("status", help="Check current scrub progress and error report")
    p_stat.add_argument("path", nargs="?", default="/", help="Mount point path (default: /)")

    p_can = subparsers.add_parser("cancel", help="Cancel ongoing scrub")
    p_can.add_argument("path", nargs="?", default="/", help="Mount point path (default: /)")

    args = parser.parse_args()

    if not args.command or args.command == "status":
        check_status(getattr(args, "path", "/"))
    elif args.command == "start":
        start_scrub(args.path)
    elif args.command == "cancel":
        cancel_scrub(args.path)

if __name__ == "__main__":
    main()
