#!/usr/bin/env python3
"""
Kalacakra OS - k-welcome
Wizard penyambutan boot pertama (First-Run Wizard).

Alur ringkas yang menyatukan tiga pilar Kalacakra:
  1. Bahasa (English / Bahasa Indonesia)
  2. Identitas visual (pilih preset Kalacakra Look)
  3. AI lokal & suara (status + opsi unduh model)
  4. Ringkasan + langkah berikutnya

Tanpa asumsi: setiap langkah memanggil tool nyata (k-look, k-ai, k-voice) dan
jujur bila prasyaratnya belum ada. Bisa dijalankan non-interaktif (--yes) agar
dapat diuji & dipakai skrip provisioning.
"""

import os
import sys
import argparse
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Bootstrap bersama (jalur library, locale, dll.)
from _kalacakra_bootstrap import get_locale_strings

# Preset Look default yang disarankan di wizard (urutan tampil).
SUGGESTED_PRESETS = [
    ("mandala-cyberpunk", "Mandala Cyberpunk", "Neon mandala Nusantara (gelap)"),
    ("nusantara-bronze", "Nusantara Bronze", "Tembaga hangat yang tenang"),
    ("obsidian-minimal", "Obsidian Minimal", "Hitam bersih, fokus"),
    ("aurora-borealis", "Aurora Borealis", "Hijau aurora sejuk"),
    ("kraton-gold", "Kraton Gold", "Hitam keraton, aksen emas"),
    ("batik-parang", "Batik Parang", "Cokelat sogan & gading Parang Rusak"),
    ("rimba-sumatra", "Rimba Sumatra", "Hijau zamrud hutan hujan & kabut emas"),
    ("jakarta-neon", "Jakarta Neon", "Biru malam metropolis & pantulan amber"),
    ("bali-senja", "Bali Senja", "Jingga-lembayung senja di balik pura"),
    ("segara-raja", "Segara Raja", "Biru pirus samudra & karang Raja Ampat"),
]


def find_bin(name: str) -> str:
    for c in (f"/usr/bin/{name}", os.path.join(SCRIPT_DIR, name)):
        if os.path.isfile(c):
            return c
    return name


def have(name: str) -> bool:
    import shutil
    return shutil.which(name) is not None


def banner(lang: str) -> None:
    print()
    print("=" * 66)
    if lang == "id":
        print("   Selamat datang di KALACAKRA OS - Roda Waktu")
        print("   Mari siapkan desktop Anda dalam beberapa langkah singkat.")
    else:
        print("   Welcome to KALACAKRA OS - The Wheel of Time")
        print("   Let's set up your desktop in a few short steps.")
    print("=" * 66)


def ask(prompt: str, default: str = "") -> str:
    try:
        val = input(prompt).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return default
    return val or default


def step_language(lang: str, assume_yes: bool) -> str:
    print()
    if lang == "id":
        print("[Langkah 1/4] Bahasa / Language")
        print("   [1] Bahasa Indonesia")
        print("   [2] English")
        chosen = "1" if assume_yes else ask("   Pilih bahasa [1/2] (default 1): ", "1")
    else:
        print("[Step 1/4] Language / Bahasa")
        print("   [1] English")
        print("   [2] Bahasa Indonesia")
        chosen = "1" if assume_yes else ask("   Choose language [1/2] (default 1): ", "1")

    new_lang = "id" if chosen in ("1", "id") else "en"
    # Cermin pilihan ke bahasa yang dipilih untuk sisa wizard.
    if new_lang == "id":
        print("   -> Bahasa diatur ke Bahasa Indonesia.")
    else:
        print("   -> Language set to English.")
    return new_lang


def step_theme(lang: str, assume_yes: bool) -> int:
    print()
    header = "[Langkah 2/4] Identitas Visual (Kalacakra Look)" if lang == "id" else "[Step 2/4] Visual Identity (Kalacakra Look)"
    print(header)
    for i, (_pid, name, desc) in enumerate(SUGGESTED_PRESETS, 1):
        print(f"   [{i}] {name} - {desc}")
    print("   [0] Lewati / Skip")
    if assume_yes:
        chosen = "1"
    else:
        n = len(SUGGESTED_PRESETS)
        prompt = f"   Pilih tema [0-{n}] (default 1): " if lang == "id" else f"   Choose theme [0-{n}] (default 1): "
        chosen = ask(prompt, "1")

    if chosen == "0":
        print("   (Tema dilewati - Anda bisa jalankan 'kalacakra look' kapan saja.)"
              if lang == "id" else
              "   (Theme skipped - run 'kalacakra look' anytime.)")
        return 0

    try:
        idx = int(chosen) - 1
        if not (0 <= idx < len(SUGGESTED_PRESETS)):
            raise ValueError
    except ValueError:
        idx = 0
    pid, name, _ = SUGGESTED_PRESETS[idx]
    print(f"   -> Menerapkan '{name}'..." if lang == "id" else f"   -> Applying '{name}'...")
    res = subprocess.run([find_bin("k-look"), "apply", pid])
    if res.returncode != 0:
        print("   (k-look melaporkan masalah; Anda bisa ulangi manual: kalacakra look apply %s)" % pid)
    return res.returncode


def step_ai(lang: str, assume_yes: bool) -> int:
    print()
    header = "[Langkah 3/4] AI Lokal & Suara" if lang == "id" else "[Step 3/4] Local AI & Voice"
    print(header)
    ollama = "aktif" if _svc_active("kalacakra-ai.service") else "nonaktif"
    print(f"   Ollama daemon : {ollama}")
    print(f"   k-ai          : {'tersedia' if have('k-ai') or os.path.isfile(find_bin('k-ai')) else 'tidak ditemukan'}")
    print(f"   whisper (k-voice): {'biner ada' if have('whisper-cli') or have('whisper-cpp') else 'belum ada model/biner'}")
    if lang == "id":
        print("   Anda bisa mengunduh model AI nanti: kalacakra install-model llama3.2:1b")
        print("   (Model besar butuh waktu; dibiarkan manual agar tak menghambat.)")
    else:
        print("   You can download an AI model later: kalacakra install-model llama3.2:1b")
        print("   (Large models take time; left manual so setup stays fast.)")
    return 0


def _svc_active(unit: str) -> bool:
    try:
        res = subprocess.run(["systemctl", "--user", "is-active", unit],
                             capture_output=True, text=True)
        return res.stdout.strip() == "active"
    except OSError:
        return False


def step_summary(lang: str) -> int:
    print()
    header = "[Langkah 4/4] Selesai!" if lang == "id" else "[Step 4/4] Done!"
    print(header)
    if lang == "id":
        print("   Kalacakra OS siap dipakai. Jelajahi:")
        print("     kalacakra showcase      # lihat identitas & tema")
        print("     kalacakra look          # ganti tema kapan saja")
        print("     kalacakra doctor        # cek kesehatan sistem")
        print("     kalacakra hub           # pusat kendali terpadu")
        print("     sudo apt install vlc    # coba: interceptor akan memandu Anda")
    else:
        print("   Kalacakra OS is ready. Explore:")
        print("     kalacakra showcase      # view identity & themes")
        print("     kalacakra look          # switch themes anytime")
        print("     kalacakra doctor        # system health check")
        print("     kalacakra hub           # unified control center")
        print("     sudo apt install vlc    # try it: the interceptor guides you")
    print()
    return 0


def detect_gui_backend() -> str | None:
    """Deteksi backend dialog GUI (kdialog/zenity) bila sesi grafis aktif."""
    has_display = bool(
        os.environ.get("DISPLAY")
        or os.environ.get("WAYLAND_DISPLAY")
        or os.environ.get("KALACAKRA_FORCE_GUI") == "1"
    )
    if not has_display:
        return None
    if have("kdialog"):
        return "kdialog"
    if have("zenity"):
        return "zenity"
    return None


def run_gui_wizard(lang: str) -> int:
    """Jalankan wizard first-run memakai dialog grafis (kdialog/zenity).
    Fallback jujur ke mode terminal bila dialog GUI tidak tersedia."""
    backend = detect_gui_backend()
    if not backend:
        print("[k-welcome] Dialog GUI (kdialog/zenity) atau sesi tampilan tidak tersedia; beralih ke mode terminal.")
        banner(lang)
        lang = step_language(lang, False)
        step_theme(lang, False)
        step_ai(lang, False)
        step_summary(lang)
        return 0

    # Langkah 1: Bahasa
    if backend == "kdialog":
        r_lang = subprocess.run(
            ["kdialog", "--title", "Kalacakra Welcome [1/3] - Bahasa / Language",
             "--radiolist", "Pilih bahasa sistem / Choose system language:",
             "id", "Bahasa Indonesia", "on" if lang == "id" else "off",
             "en", "English", "on" if lang != "id" else "off"],
            capture_output=True, text=True,
        )
    else:
        r_lang = subprocess.run(
            ["zenity", "--list", "--radiolist",
             "--title=Kalacakra Welcome [1/3] - Bahasa / Language",
             "--text=Pilih bahasa sistem / Choose system language:",
             "--column=", "--column=Kode", "--column=Bahasa",
             "TRUE" if lang == "id" else "FALSE", "id", "Bahasa Indonesia",
             "TRUE" if lang != "id" else "FALSE", "en", "English"],
            capture_output=True, text=True,
        )
    if r_lang.returncode != 0 or not r_lang.stdout.strip():
        print("Dibatalkan.")
        return 0
    lang = "id" if r_lang.stdout.strip() == "id" else "en"

    # Langkah 2: Tema Look
    if backend == "kdialog":
        cmd_theme = [
            "kdialog", "--title", "Kalacakra Welcome [2/3] - Kalacakra Look",
            "--radiolist",
            "Pilih identitas visual desktop:" if lang == "id" else "Choose desktop visual identity:",
        ]
        for i, (pid, name, desc) in enumerate(SUGGESTED_PRESETS):
            cmd_theme.extend([pid, f"{name} - {desc}", "on" if i == 0 else "off"])
        cmd_theme.extend(["skip", "Lewati / Skip", "off"])
    else:
        cmd_theme = [
            "zenity", "--list", "--radiolist",
            "--title=Kalacakra Welcome [2/3] - Kalacakra Look",
            "--text=" + ("Pilih identitas visual desktop:" if lang == "id" else "Choose desktop visual identity:"),
            "--column=", "--column=ID", "--column=Tema", "--column=Deskripsi",
            "--width=720", "--height=460",
        ]
        for i, (pid, name, desc) in enumerate(SUGGESTED_PRESETS):
            cmd_theme.extend(["TRUE" if i == 0 else "FALSE", pid, name, desc])
        cmd_theme.extend(["FALSE", "skip", "Lewati / Skip", "-"])

    r_theme = subprocess.run(cmd_theme, capture_output=True, text=True)
    chosen_theme = r_theme.stdout.strip()
    if r_theme.returncode == 0 and chosen_theme and chosen_theme != "skip":
        subprocess.run([find_bin("k-look"), "apply", chosen_theme])

    # Langkah 3: Ringkasan & Status AI
    ollama = "aktif" if _svc_active("kalacakra-ai.service") else "nonaktif"
    if lang == "id":
        summary_msg = (
            f"Selamat datang di Kalacakra OS!\n\n"
            f"- Bahasa: Bahasa Indonesia\n"
            f"- Tema Look: {chosen_theme or 'dilewati'}\n"
            f"- Daemon AI Lokal (Ollama): {ollama}\n\n"
            f"Perintah berguna:\n"
            f"  kalacakra look gui      (pemilih tema grafis)\n"
            f"  kalacakra showcase      (layar identitas)\n"
            f"  kalacakra hub           (pusat kendali)\n"
            f"  sudo apt install vlc    (interceptor pintar)"
        )
    else:
        summary_msg = (
            f"Welcome to Kalacakra OS!\n\n"
            f"- Language: English\n"
            f"- Look Theme: {chosen_theme or 'skipped'}\n"
            f"- Local AI Daemon (Ollama): {ollama}\n\n"
            f"Useful commands:\n"
            f"  kalacakra look gui      (graphical theme picker)\n"
            f"  kalacakra showcase      (identity screen)\n"
            f"  kalacakra hub           (control center)\n"
            f"  sudo apt install vlc    (smart interceptor)"
        )

    if backend == "kdialog":
        subprocess.run(["kdialog", "--title", "Kalacakra Welcome [3/3]", "--msgbox", summary_msg],
                       capture_output=True, text=True)
    else:
        subprocess.run(["zenity", "--info", "--title=Kalacakra Welcome [3/3]", f"--text={summary_msg}"],
                       capture_output=True, text=True)
    print(summary_msg)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="k-welcome",
        description="Kalacakra OS First-Run Welcome Wizard",
    )
    parser.add_argument("--lang", choices=["id", "en"], help="Bahasa awal wizard")
    parser.add_argument("--yes", "-y", action="store_true",
                        help="Non-interaktif: terima semua default (untuk provisioning/uji)")
    parser.add_argument("--gui", "-g", action="store_true",
                        help="Jalankan wizard memakai dialog grafis (kdialog/zenity)")
    parser.add_argument("--no-color", action="store_true", help="Matikan warna ANSI")
    args = parser.parse_args()

    if args.no_color:
        os.environ["NO_COLOR"] = "1"

    strings, current_lang = get_locale_strings(args.lang)
    lang = args.lang or current_lang

    if args.gui and not args.yes:
        return run_gui_wizard(lang)

    banner(lang)
    lang = step_language(lang, args.yes)
    step_theme(lang, args.yes)
    step_ai(lang, args.yes)
    step_summary(lang)
    return 0


if __name__ == "__main__":
    sys.exit(main())
