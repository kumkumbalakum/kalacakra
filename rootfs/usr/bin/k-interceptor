#!/usr/bin/env python3
"""
Kalacakra OS - Universal Command Interceptor
Intercepts traditional package manager commands (apt, pacman, yay) on the immutable host
and guides the user to install software cleanly via Flatpak, Spaces (Distrobox), Homebrew, or ostree.
"""

import os
import sys
import shutil
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Path library bersama ditangani oleh _kalacakra_bootstrap.

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import get_locale_strings, extract_target_packages

def find_k_aur():
    candidates = [
        "/usr/bin/k-aur",
        os.path.join(SCRIPT_DIR, "k-aur")
    ]
    for c in candidates:
        if os.path.isfile(c):
            return c
    return "k-aur"


# ---------------------------------------------------------------------------
# Deteksi backend cerdas (pillar "immutable yang tidak menyakitkan")
# ---------------------------------------------------------------------------
