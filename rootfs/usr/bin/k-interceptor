# Nama paket CLI murni yang lebih pas via Homebrew (bukan GUI).
BREW_PREFERRED = {
    "ripgrep", "rg", "fd", "fd-find", "fzf", "bat", "eza", "exa", "zoxide",
    "delta", "git-delta", "gh", "glab", "httpie", "xh", "jq", "yq", "hugo",
