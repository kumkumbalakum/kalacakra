    "mkcert", "kubectl", "k9s", "helm", "terraform", "opentofu", "ansible",
    "rclone", "restic", "yt-dlp", "ffmpeg", "imagemagick", "aria2", "mtr",
    "nmap", "tig", "glow", "gum", "atuin", "carapace", "nushell", "fish",
    "zsh", "curl", "wget",
}

# Pemetaan nama paket distro (Debian/Arch) ke nama formula Homebrew resmi.
BREW_ALIASES = {
    "rg": "ripgrep",
    "fd-find": "fd",
    "exa": "eza",
    "git-delta": "delta",
    "nodejs": "node",
    "golang": "go",
    "nvim": "neovim",
    "hx": "helix",
    "btm": "bottom",
}

# Paket driver/daemon level host yang memang harus di-layer via rpm-ostree.
HOST_LAYER_PREFERRED = {
    "libvirt", "qemu-kvm", "virt-install", "tailscale", "wireguard-tools",
    "usbguard", "scx-scheds", "akmod-nvidia", "xorg-x11-drv-nvidia",
}


def backend_available(backend: str) -> bool:
    """Cek jujur apakah sebuah backend benar-benar tersedia di sistem."""
    if backend == "flatpak":
        return shutil.which("flatpak") is not None
    if backend == "arch":
        return shutil.which("distrobox") is not None
    if backend == "debian":
        return shutil.which("distrobox") is not None
    if backend == "brew":
        return shutil.which("brew") is not None
    if backend == "layer":
        return shutil.which("rpm-ostree") is not None
    return False


def recommend_backend(packages: list[str], intercepted_cmd: str = "") -> tuple[str, str]:
    """Pilih backend terbaik berdasarkan nama paket. Mengembalikan
    (pilihan_menu, alasan_singkat). Jujur: hanya rekomendasikan yang tersedia."""
    pkgs = [p.lower() for p in packages]
    known_flatpak = [p for p in pkgs if p in FLATPAK_ALIASES]
    known_brew = [p for p in pkgs if p in BREW_PREFERRED]
    known_layer = [p for p in pkgs if p in HOST_LAYER_PREFERRED]
    is_aur = intercepted_cmd.lower() in ("yay", "paru") or any(
        p.endswith(("-bin", "-git", "-aur")) for p in pkgs
    )

    if known_flatpak and backend_available("flatpak"):
        first = known_flatpak[0]
        return "1", f"'{first}' tersedia sebagai aplikasi Flatpak resmi ({FLATPAK_ALIASES[first]})"
    if known_brew and backend_available("brew"):
        return "4", f"'{known_brew[0]}' cocok sebagai alat CLI via Homebrew"
    if is_aur and backend_available("arch"):
        return "2", "paket AUR cocok dipasang di Kalacakra Arch Space (k-aur)"
    if known_layer and backend_available("layer"):
        return "5", f"'{known_layer[0]}' adalah komponen sistem/driver yang perlu di-layer ke host"
    # Default aman: Flatpak bila ada untuk GUI, jika tidak biarkan user memilih.
    if backend_available("flatpak"):
        return "1", "Flatpak (aman untuk desktop, tidak mengubah host)"
    return "", ""


def lookup_package(pkg: str) -> dict:
    """Kembalikan informasi pemetaan untuk satu nama paket."""
    key = pkg.strip().lower()
    if key in FLATPAK_ALIASES:
        return {
            "query": pkg,
            "backend": "flatpak",
            "option": "1",
            "target": FLATPAK_ALIASES[key],
            "available": backend_available("flatpak"),
        }
    if key in BREW_PREFERRED:
        return {
            "query": pkg,
            "backend": "brew",
            "option": "4",
            "target": BREW_ALIASES.get(key, key),
            "available": backend_available("brew"),
        }
    if key in HOST_LAYER_PREFERRED:
        return {
            "query": pkg,
            "backend": "layer",
            "option": "5",
            "target": key,
            "available": backend_available("layer"),
        }
    if key.endswith(("-bin", "-git", "-aur")):
        return {
            "query": pkg,
            "backend": "arch",
            "option": "2",
            "target": key,
            "available": backend_available("arch"),
        }
    return {
        "query": pkg,
        "backend": "unknown",
        "option": "1" if backend_available("flatpak") else "",
        "target": pkg,
        "available": backend_available("flatpak"),
    }


def _print_aliases() -> int:
    print(f"=== Kalacakra Interceptor - Basis Data Alias ({len(FLATPAK_ALIASES)} Flatpak, {len(BREW_PREFERRED)} Homebrew) ===")
    print("\n[Flatpak -> Flathub ID]")
    for name in sorted(FLATPAK_ALIASES):
        print(f"  {name:<26} -> {FLATPAK_ALIASES[name]}")
    print(f"\n[Homebrew CLI ({len(BREW_PREFERRED)} paket)]")
    print("  " + ", ".join(sorted(BREW_PREFERRED)))
    return 0


def _print_lookup(pkg: str) -> int:
    info = lookup_package(pkg)
    status = "tersedia" if info["available"] else "backend belum terpasang"
    print(f"Paket    : {info['query']}")
    print(f"Backend  : {info['backend']} (opsi {info['option'] or '-'}) [{status}]")
    print(f"Target   : {info['target']}")
    return 0


def main():
    if len(sys.argv) < 2:
        print("Usage: k-interceptor <command> [args...]")
        print("       k-interceptor --lookup <pkg> | --list-aliases")
        sys.exit(1)

    if sys.argv[1] == "--list-aliases":
        sys.exit(_print_aliases())
    if sys.argv[1] == "--lookup":
        if len(sys.argv) < 3:
            print("Usage: k-interceptor --lookup <pkg>")
            sys.exit(1)
        sys.exit(_print_lookup(sys.argv[2]))

    intercepted_cmd = sys.argv[1]
    cmd_args = sys.argv[2:]
    strings, current_lang = get_locale_strings()

    packages = extract_target_packages(cmd_args)
    pkg_str = " ".join(packages) if packages else " ".join(cmd_args)

    print()
    print(strings.get("interceptor_title", "[Kalacakra Interceptor] Host system is Immutable (Protected)."))
    msg_available = strings.get("interceptor_pkg_available", "Command '{cmd} {args}' detected.").format(
        cmd=intercepted_cmd,
        args=" ".join(cmd_args)
    )
    print(msg_available)

    # Rekomendasi pintar + satu tombol Enter untuk menerima default.
    rec_choice, rec_reason = recommend_backend(packages, intercepted_cmd)
    if rec_choice:
        if current_lang == "id":
            rec_line = f"[Kalacakra] Rekomendasi: opsi {rec_choice} - {rec_reason}."
            hint = "        Tekan Enter untuk memakai rekomendasi, atau pilih 1-5."
        else:
            rec_line = f"[Kalacakra] Recommendation: option {rec_choice} - {rec_reason}."
            hint = "        Press Enter to accept the recommendation, or choose 1-5."
        print(rec_line)
        print(hint)

    print()
    print(strings.get("interceptor_prompt", "Choose your preferred installation method:"))
    print(f"  [1] {strings.get('interceptor_opt_flatpak', 'Flatpak (Recommended for GUI apps)')}")
    print(f"  [2] {strings.get('interceptor_opt_arch', 'Kalacakra Space (Arch Linux Container / AUR via k-aur)')}")
    print(f"  [3] {strings.get('interceptor_opt_debian', 'Kalacakra Space (Debian / Ubuntu Container)')}")
    print(f"  [4] {strings.get('interceptor_opt_brew', 'Homebrew on Linux (CLI tool isolated in /home)')}")
    print(f"  [5] {strings.get('interceptor_opt_layer', 'Layer to Host OS (rpm-ostree - requires reboot)')}")
    print()

    choice_prompt = strings.get("interceptor_choice", "Your choice [1-5]: ")
    try:
        choice = input(choice_prompt).strip()
    except (KeyboardInterrupt, EOFError):
        print("\nAborted.")
        sys.exit(0)

    # Enter kosong = terima rekomendasi pintar (bila ada).
    if choice == "" and rec_choice:
        choice = rec_choice

    # Untuk opsi Flatpak, terjemahkan nama umum ke ID Flathub bila dikenali.
    flatpak_targets = [FLATPAK_ALIASES.get(p.lower(), p) for p in packages]
    # Untuk opsi Homebrew, terjemahkan alias paket distro ke nama formula brew.
    brew_targets = [BREW_ALIASES.get(p.lower(), p) for p in packages]

    if choice == "1":
        if not backend_available("flatpak"):
            print("\n[k-interceptor Error] 'flatpak' tidak terpasang.")
            print("   Pasang: sudo rpm-ostree install flatpak   (lalu reboot)")
            sys.exit(1)
        print(f"\n[Kalacakra] Searching and installing via Flatpak for: {pkg_str}...")
        for pkg in flatpak_targets:
            subprocess.run(["flatpak", "install", "--user", "flathub", pkg])
    elif choice == "2":
        k_aur_bin = find_k_aur()
        print(f"\n[Kalacakra] Forwarding to Kalacakra Arch Space (k-aur) for: {pkg_str}...")
        subprocess.run([k_aur_bin, "install"] + packages)
    elif choice == "3":
        if not shutil.which("distrobox"):
            print("\n[k-interceptor Error] 'distrobox' tidak terpasang - Space Debian tidak bisa dibuat.")
            print("   Pasang: sudo rpm-ostree install distrobox   (lalu reboot)")
            sys.exit(1)
        print("\n[Kalacakra] Ensuring Debian space exists...")
        subprocess.run(["distrobox", "create", "--name", "kalacakra-debian", "--image", "debian:stable", "--yes"], check=False)
        print(f"[Kalacakra] Installing inside Debian space: {pkg_str}...")
        subprocess.run(["distrobox", "enter", "kalacakra-debian", "--", "sudo", "apt", "update"])
        subprocess.run(["distrobox", "enter", "kalacakra-debian", "--", "sudo", "apt", "install", "-y"] + packages)
    elif choice == "4":
        if not shutil.which("brew"):
            print("\n[k-interceptor Error] 'brew' (Homebrew) tidak terpasang.")
            print("   Pasang Homebrew Linux: https://brew.sh")
            print("   (atau pilih opsi lain: Flatpak / Spaces / rpm-ostree layering).")
            sys.exit(1)
        print(f"\n[Kalacakra] Installing via Homebrew: {pkg_str}...")
        subprocess.run(["brew", "install"] + brew_targets)
    elif choice == "5":
        print(f"\n[Kalacakra] Layering package to immutable host: {pkg_str}...")
        subprocess.run(["sudo", "rpm-ostree", "install"] + packages)
    else:
        print(strings.get("interceptor_invalid", "Invalid choice."))
        sys.exit(1)

if __name__ == "__main__":
    main()
