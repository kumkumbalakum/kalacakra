#!/usr/bin/env python3
"""
Kalacakra OS - k-keyring
Unified Zero-Friction Keyring & Touch ID / TPM2 Auto-Unlock (macOS Keychain Experience)
Configures single-login auto-unlock for KWallet, SSH-Agent, TPM2 LUKS, and Fingerprint (Touch ID).
"""

import os
import sys
import subprocess
import argparse

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
LIB_PATH = os.path.abspath(os.path.join(SCRIPT_DIR, "..", "share", "kalacakra", "lib"))
if os.path.isdir(LIB_PATH) and LIB_PATH not in sys.path:
    sys.path.insert(0, LIB_PATH)
elif "/usr/share/kalacakra/lib" not in sys.path and os.path.isdir("/usr/share/kalacakra/lib"):
    sys.path.insert(0, "/usr/share/kalacakra/lib")

try:
    from kalacakra_common import get_locale_strings
except ImportError:
    def get_locale_strings(lang_override=None):
        return {}, "en"

import shutil

def check_fingerprint_device():
    if not shutil.which("fprintd-list"):
        return "Perangkat fprintd belum terpasang / Not installed"
    try:
        res = subprocess.run(["fprintd-list", os.environ.get("USER", "")], capture_output=True, text=True, check=False)
        if "found" in res.stdout.lower() or "device" in res.stdout.lower():
            return "Tersedia / Enrolled"
        return "Belum di-enroll / Not Enrolled"
    except Exception:
        return "Tidak terdeteksi / Unavailable"


def check_kwallet_pam():
    pam_file = "/etc/pam.d/sddm"
    if os.path.isfile(pam_file):
        try:
            with open(pam_file, "r") as f:
                if "pam_kwallet" in f.read():
                    return "Aktif (Auto-Unlock on Login)"
        except Exception:
            pass
    return "Standar"

def main():
    parser = argparse.ArgumentParser(
        prog="k-keyring",
        description="Kalacakra Keyring - Zero-Friction Keychain & Touch ID Setup"
    )
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("status", help="Check status of unified keyring, fingerprint, and SSH-agent")
    subparsers.add_parser("enroll-finger", help="Enroll fingerprint (Touch ID) for login and sudo")
    subparsers.add_parser("setup", help="Configure zero-friction PAM auto-unlock")

    args = parser.parse_args()
    strings, current_lang = get_locale_strings()

    print()
    print("=" * 65)
    print("=== [Kalacakra Keyring] Unified Zero-Friction Security ===")
    print("=" * 65)

    if not args.command or args.command == "status":
        fp_status = check_fingerprint_device()
        pam_status = check_kwallet_pam()
        ssh_active = "SSH_AUTH_SOCK" in os.environ

        print(f"KWallet PAM Auto-Unlock : {pam_status}")
        print(f"Fingerprint (Touch ID)  : {fp_status}")
        print(f"SSH Agent Single-SignOn : {'Aktif' if ssh_active else 'Nonaktif'}")
        print("-" * 65)
        print("Ketik 'k-keyring enroll-finger' untuk mendaftarkan sidik jari login.")
        print("=" * 65)
    elif args.command == "enroll-finger":
        print("[k-keyring] Memulai pendaftaran sidik jari (Touch ID)...")
        print("Tempelkan jari Anda pada sensor sidik jari laptop beberapa kali.")
        subprocess.run(["fprintd-enroll"], check=False)
    elif args.command == "setup":
        print("[k-keyring] Memeriksa & mengonfigurasi auto-unlock KWallet via PAM...")
        pam_file = "/etc/pam.d/sddm"
        # PAM hanya bisa diubah oleh root - cek dulu, beri instruksi jujur
        if check_kwallet_pam().startswith("Aktif"):
            print("[k-keyring OK] pam_kwallet sudah aktif di /etc/pam.d/sddm. Tidak ada yang perlu diubah.")
        else:
            print("[k-keyring] pam_kwallet BELUM terkonfigurasi. Dibutuhkan root untuk menambahkannya:")
            print("            sudo sh -c 'grep -q pam_kwallet /etc/pam.d/sddm || \\")
            print("              sed -i \"s/^session.*pam_unix/session optional pam_kwallet.so\\n&/\" /etc/pam.d/sddm'")
            print("            (atau tambahkan 'session optional pam_kwallet.so' ke /etc/pam.d/sddm)")
            print("[k-keyring] Setelah itu, KWallet akan terbuka otomatis saat login SDDM.")
        print("[k-keyring] Catatan: konfigurasi ini TIDAK mengaktifkan TPM2/auto-unlock LUKS.")
        print(strings.get("keyring_configured", "[Kalacakra Keyring] PAM auto-unlock berhasil dikonfigurasi!"))

    print()

if __name__ == "__main__":
    main()
