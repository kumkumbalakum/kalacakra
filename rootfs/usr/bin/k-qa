#!/usr/bin/env python3
"""
Kalacakra OS - k-qa (Automated Quality Assurance & Verification Engine)
openQA-inspired sanity and regression testing suite for image integrity,
security configurations, locale completeness, and desktop integration.
"""

import os
import sys
import json
import argparse

if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Path library bersama ditangani oleh _kalacakra_bootstrap.

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import resolve_locales_dir

def run_qa_tests():
    results = []

    # Test 1: Locales Integrity
    loc_dir = resolve_locales_dir()
    id_file = os.path.join(loc_dir, "id.json")
    en_file = os.path.join(loc_dir, "en.json")
    if os.path.isfile(id_file) and os.path.isfile(en_file):
        try:
            with open(id_file, "r", encoding="utf-8") as f:
                d_id = json.load(f)
            with open(en_file, "r", encoding="utf-8") as f:
                d_en = json.load(f)
            common_keys = set(d_id.keys()).intersection(set(d_en.keys()))
            results.append({
                "name": "i18n Locale Dictionaries Completeness",
                "status": "PASS",
                "details": f"{len(common_keys)} synchronized dual-language keys verified."
            })
        except Exception as e:
            results.append({
                "name": "i18n Locale Dictionaries Completeness",
                "status": "FAIL",
                "details": str(e)
            })
    else:
        results.append({
            "name": "i18n Locale Dictionaries Completeness",
            "status": "FAIL",
            "details": f"Missing id.json or en.json in {loc_dir}"
        })

    # Test 2: Core Kalacakra CLI Suite Binaries
    expected_bins = [
        "kalacakra", "k-interceptor", "k-ai", "k-aur", "k-doctor",
        "k-rewind", "k-beam", "k-portal", "k-ocr", "k-survival", "k-precache",
        "k-preview", "k-spotlight", "k-flow", "k-snippet", "k-keyring",
        "k-hub", "k-qa", "k-snapboot", "k-profile", "k-pkg",
        "k-jail", "k-be", "k-scrub", "k-trace", "k-sysrc",
        "k-unveil", "k-signify", "k-pf", "k-doas", "k-wx",
        "k-voice", "k-game", "k-look", "k-showcase", "k-welcome", "k-ask"
    ]
    missing_bins = []
    for b in expected_bins:
        candidates = [
            f"/usr/bin/{b}",
            os.path.join(SCRIPT_DIR, b)
        ]
        if not any(os.path.isfile(c) for c in candidates):
            missing_bins.append(b)

    if not missing_bins:
        results.append({
            "name": "Core Executables & CLI Suite Availability",
            "status": "PASS",
            "details": f"All {len(expected_bins)} core binaries accounted for."
        })
    else:
        results.append({
            "name": "Core Executables & CLI Suite Availability",
            "status": "FAIL",
            "details": f"Missing binaries: {', '.join(missing_bins)}"
        })

    # Test 3: Security Hardening Configurations
    sec_candidates = [
        "/etc/sysctl.d/99-kalacakra-security.conf",
        os.path.abspath(os.path.join(SCRIPT_DIR, "..", "..", "etc", "sysctl.d", "99-kalacakra-security.conf"))
    ]
    if any(os.path.isfile(s) for s in sec_candidates):
        results.append({
            "name": "Kernel Sysctl Security Hardening Manifest",
            "status": "PASS",
            "details": "kptr_restrict, unprivileged_bpf, and network hardening present."
        })
    else:
        results.append({
            "name": "Kernel Sysctl Security Hardening Manifest",
            "status": "WARN",
            "details": "Security sysctl file not found in tested paths."
        })

    # Test 4: Desktop KIO Service Menu Integrations
    kio_candidates = [
        "/usr/share/kio/servicemenus/kalacakra-preview.desktop",
        os.path.abspath(os.path.join(SCRIPT_DIR, "..", "share", "kio", "servicemenus", "kalacakra-preview.desktop"))
    ]
    if any(os.path.isfile(k) for k in kio_candidates):
        results.append({
            "name": "Dolphin KIO ServiceMenu Quick Look & Actions",
            "status": "PASS",
            "details": "Spacebar preview & context actions registered."
        })
    else:
        results.append({
            "name": "Dolphin KIO ServiceMenu Quick Look & Actions",
            "status": "WARN",
            "details": "Dolphin service menu not detected in current path."
        })

    # Test 5: Shared Library Import Test
    try:
        import kalacakra_common  # noqa: F401 - import test saja
        _ = kalacakra_common.__name__
        results.append({
            "name": "Shared Python Library (kalacakra_common) Import",
            "status": "PASS",
            "details": "Common functions, secret sanitizers, and locale resolvers active."
        })
    except Exception as e:
        results.append({
            "name": "Shared Python Library (kalacakra_common) Import",
            "status": "FAIL",
            "details": str(e)
        })

    return results

def main():
    parser = argparse.ArgumentParser(
        prog="k-qa",
        description="Kalacakra QA - openQA-style Automated Image & System Regression Testing"
    )
    parser.add_argument("--json", action="store_true", help="Output results in JSON format for CI/CD")
    args = parser.parse_args()

    results = run_qa_tests()
    failures = [r for r in results if r["status"] == "FAIL"]

    if args.json:
        print(json.dumps({
            "passed": len(failures) == 0,
            "total": len(results),
            "failures": len(failures),
            "results": results
        }, indent=2))
        sys.exit(1 if failures else 0)

    print()
    print("=" * 70)
    print("=== [Kalacakra QA Engine] openQA-Style Automated Verification ===")
    print("=" * 70)
    for r in results:
        badge = "  [PASS]  " if r["status"] == "PASS" else ("  [WARN]  " if r["status"] == "WARN" else "  [FAIL]  ")
        print(f"{badge} {r['name']}")
        print(f"           └─ {r['details']}")
    print("-" * 70)

    if not failures:
        print("[Kalacakra QA] Status: SEMUA PENGUJIAN INTEGRITAS SISTEM BERHASIL (PASSED)!")
        print("=" * 70)
        print()
        sys.exit(0)
    else:
        print(f"[Kalacakra QA] Status: TERDETEKSI {len(failures)} KEGAGALAN REGRESI!")
        print("=" * 70)
        print()
        sys.exit(1)

if __name__ == "__main__":
    main()
