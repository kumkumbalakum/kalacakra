#!/usr/bin/env python3
"""
Kalacakra OS - k-snapboot
Btrfs Snapper Bootloader Integration (openSUSE grub2-snapper-plugin style)
Generates and synchronizes bootloader entries for historical Snapper snapshots,
enabling users to boot directly into earlier system states from the boot menu.
"""

import os
import sys
import shutil
import subprocess
import argparse

if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
LIB_PATH = os.path.abspath(os.path.join(SCRIPT_DIR, "..", "share", "kalacakra", "lib"))
if os.path.isdir(LIB_PATH) and LIB_PATH not in sys.path:
    sys.path.insert(0, LIB_PATH)
elif "/usr/share/kalacakra/lib" not in sys.path and os.path.isdir("/usr/share/kalacakra/lib"):
    sys.path.insert(0, "/usr/share/kalacakra/lib")

try:
    from kalacakra_common import get_locale_strings
except ImportError:
    def get_locale_strings(lang_override=None):
        return {}, "en"

BOOT_ENTRIES_DIR = "/boot/loader/entries"

def get_snapper_snapshots():
    """Ambil daftar snapshot Snapper ASLI. Kosong jika snapper tidak tersedia."""
    snapshots = []
    if shutil.which("snapper"):
        try:
            res = subprocess.run(["snapper", "--csvout", "list"], capture_output=True, text=True, check=False)
            lines = res.stdout.strip().splitlines()
            for line in lines[1:]:
                parts = line.split(",")
                if len(parts) >= 6:
                    snapshots.append({
                        "id": parts[0].strip(),
                        "type": parts[1].strip(),
                        "date": parts[3].strip(),
                        "desc": parts[5].strip()
                    })
        except Exception:
            pass
    # Tidak ada data dummy - daftar kosong lebih jujur daripada snapshot fiktif
    return snapshots

def sync_bootloader_entries():
    """Sinkronkan snapshot Snapper nyata ke /boot/loader/entries.
    Mengembalikan (jumlah_sukses, jumlah_gagal)."""
    snapshots = get_snapper_snapshots()
    if not snapshots:
        return 0, 0

    synced, failed = 0, 0
    can_write = os.path.isdir("/boot") and os.access("/boot", os.W_OK)
    if not can_write:
        # Coba dengan sudo nanti? laporkan jujur
        return 0, len([s for s in snapshots if s["id"] != "0"])

    for snap in snapshots:
        if snap["id"] == "0":
            continue
        entry_file = os.path.join(BOOT_ENTRIES_DIR, f"kalacakra-snapshot-{snap['id']}.conf")
        content = f"""# Kalacakra OS - Bootable Btrfs Snapshot #{snap['id']}
title      Kalacakra OS (Snapshot #{snap['id']} - {snap['desc']})
version    snapshot-{snap['id']}
options    root=UUID=kalacakra-root rootflags=subvol=.snapshots/{snap['id']}/snapshot ro quiet splash
"""
        try:
            os.makedirs(BOOT_ENTRIES_DIR, exist_ok=True)
            with open(entry_file, "w") as f:
                f.write(content)
            synced += 1
        except Exception:
            failed += 1

    return synced, failed

def list_bootable_snapshots():
    snapshots = get_snapper_snapshots()
    print()
    print("=" * 72)
    print("=== [Kalacakra SnapBoot] Daftar Titik Booting Snapshot Btrfs ===")
    print("=" * 72)
    if not snapshots:
        if not shutil.which("snapper"):
            print(" [INFO] 'snapper' tidak terpasang - tidak ada snapshot untuk ditampilkan.")
            print("        Pasang snapper & konfigurasikan subvolume @/.snapshots terlebih dahulu.")
        else:
            print(" [INFO] Belum ada snapshot terdaftar. Buat dengan: k-rewind create <deskripsi>")
        print("=" * 72)
        print()
        return
    print(f" {'ID':<6} {'TIPE':<10} {'TANGGAL / WAKTU':<22} {'DESKRIPSI':<30}")
    print("-" * 72)
    for s in snapshots:
        marker = "▶" if s["id"] == "0" else " "
        print(f"{marker}{s['id']:<5} {s['type']:<10} {s['date']:<22} {s['desc'][:30]:<30}")
    print("-" * 72)
    print("Gunakan 'k-snapboot sync' untuk memperbarui entri menu bootloader.")
    print("=" * 72)
    print()

def main():
    parser = argparse.ArgumentParser(
        prog="k-snapboot",
        description="Kalacakra SnapBoot - Btrfs Snapper Bootloader Integration (openSUSE Style)"
    )
    subparsers = parser.add_subparsers(dest="command")
    subparsers.add_parser("list", help="List available bootable snapshots")
    subparsers.add_parser("sync", help="Sync Snapper snapshots to systemd-boot / GRUB menu")
    
    p_sel = subparsers.add_parser("select", help="Set a specific snapshot as next default boot target")
    p_sel.add_argument("id", help="Snapshot ID to boot into")

    args = parser.parse_args()
    strings, current_lang = get_locale_strings()

    if not args.command or args.command == "list":
        list_bootable_snapshots()
    elif args.command == "sync":
        synced, failed = sync_bootloader_entries()
        print(strings.get("snapboot_synced", "Entri bootloader snapshot berhasil disinkronisasi!"))
        print(f"[Kalacakra SnapBoot] Berhasil: {synced} | Gagal: {failed}")
        if synced == 0 and failed == 0:
            print("[Kalacakra SnapBoot] Tidak ada snapshot untuk disinkronkan (snapper kosong/absen).")
            sys.exit(1)
        elif failed:
            sys.exit(1)
    elif args.command == "select":
        snap_id = args.id
        snap = next((s for s in get_snapper_snapshots() if s["id"] == snap_id), None)
        if snap is None:
            print(f"[Kalacakra SnapBoot Error] Snapshot #{snap_id} tidak ditemukan. Jalankan 'k-snapboot list'.")
            sys.exit(1)
        entry_file = os.path.join(BOOT_ENTRIES_DIR, f"kalacakra-snapshot-{snap_id}.conf")
        if not os.path.isfile(entry_file):
            print(f"[Kalacakra SnapBoot] Entri boot untuk snapshot #{snap_id} belum ada.")
            print("Jalankan 'k-snapboot sync' terlebih dahulu.")
            sys.exit(1)
        print(f"[Kalacakra SnapBoot] Menjadwalkan booting ke Snapshot #{snap_id} pada reboot berikutnya...")
        entry_id = f"kalacakra-snapshot-{snap_id}"
        if shutil.which("bootctl"):
            res = subprocess.run(["bootctl", "set-oneshot", entry_id], check=False)
            if res.returncode == 0:
                print(f"[Kalacakra SnapBoot OK] Boot one-shot diatur ke '{entry_id}'.")
                print("[Kalacakra SnapBoot] Sistem akan dimuat dalam mode read-only aman.")
            else:
                print("[Kalacakra SnapBoot Error] bootctl gagal mengatur one-shot entry.")
                sys.exit(res.returncode)
        else:
            print("[Kalacakra SnapBoot Error] 'bootctl' tidak tersedia - tidak bisa menjadwalkan boot.")
            print("Pilih manual entri snapshot dari menu boot (GRUB/systemd-boot) saat restart.")
            sys.exit(1)

if __name__ == "__main__":
    main()
