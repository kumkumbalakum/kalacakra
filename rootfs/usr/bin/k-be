#!/usr/bin/env python3
"""
Kalacakra OS - k-be (ZFS Boot Environments Engine)
FreeBSD bectl-inspired Boot Environment manager for atomic Linux deployments.
Manages ostree/bootc deployments and Btrfs root snapshots with instant cloning,
activation, and rollback.
"""

import os
import sys
import json
import shutil
import subprocess
import argparse

if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Path library bersama ditangani oleh _kalacakra_bootstrap.

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import get_locale_strings

def get_boot_environments():
    bes = []
    if shutil.which("rpm-ostree"):
        try:
            res = subprocess.run(["rpm-ostree", "status", "--json"], capture_output=True, text=True, check=False)
            data = json.loads(res.stdout)
            deployments = data.get("deployments", [])
            for idx, dep in enumerate(deployments):
                booted = dep.get("booted", False)
                pinned = dep.get("pinned", False)
                version = dep.get("version", f"deployment-{idx}")
                osname = dep.get("osname", "kalacakra")
                checksum = dep.get("checksum", "")[:12]
                active_flag = "NR" if (booted and idx == 0) else ("N" if idx == 0 else ("R" if booted else "-"))
                bes.append({
                    "id": str(idx),
                    "name": f"{osname}-{version}" + (" [PIN]" if pinned else ""),
                    "active": active_flag,
                    "mountpoint": "/" if booted else "-",
                    "pinned": pinned,
                    "created": checksum
                })
        except Exception:
            pass

    # Tidak ada data dummy - daftar kosong lebih jujur daripada BE fiktif
    return bes

def list_be():
    bes = get_boot_environments()
    print()
    print("=" * 75)
    print("=== [Kalacakra Boot Environments] Pengelola Deployment Ala bectl ===")
    print("=" * 75)
    if not bes:
        if not shutil.which("rpm-ostree"):
            print(" [INFO] 'rpm-ostree' tidak terpasang - daftar deployment tidak tersedia.")
        else:
            print(" [INFO] Tidak ada deployment terdaftar (rpm-ostree status kosong/gagal).")
        print("=" * 75)
        print()
        return
    print(f" {'ID':<4} {'BE NAME':<38} {'ACTIVE':<8} {'CHECKSUM':<10}")
    print("-" * 75)
    for be in bes:
        print(f" {be['id']:<4} {be['name']:<38} {be['active']:<8} {be['created']:<10}")
    print("-" * 75)
    print(" Keterangan Active: 'N' = Next Boot Default, 'R' = Running / Active Now, [PIN] = terkunci")
    print(" Perintah: 'k-be create <name>', 'k-be activate <id>', 'k-be destroy <id>'")
    print("=" * 75)
    print()

def create_be(name: str):
    print(f"[Kalacakra BE] Membuat pin Boot Environment dari deployment berjalan (label: '{name}')...")
    if not shutil.which("ostree"):
        print("[Kalacakra BE Error] 'ostree' tidak terpasang - TIDAK ada BE yang dibuat.")
        sys.exit(1)
    # Catatan jujur: ostree admin pin tidak bisa memberi nama klon - 'name' hanya label di metadata
    res = subprocess.run(["ostree", "admin", "pin", "0"], check=False)
    if res.returncode != 0:
        print(f"[Kalacakra BE Error] 'ostree admin pin' gagal (kode {res.returncode}).")
        sys.exit(res.returncode)
    print(f"[Kalacakra BE OK] Deployment #0 dipin permanen. Label: '{name}' (label lokal, bukan nama BE ostree).")

def activate_be(target_id: str):
    strings, current_lang = get_locale_strings()
    if not shutil.which("ostree"):
        print("[Kalacakra BE Error] 'ostree' tidak terpasang - TIDAK ada BE yang diaktifkan.")
        sys.exit(1)
    print(f"[Kalacakra BE] Mengaktifkan Boot Environment #{target_id} sebagai default boot berikutnya...")
    res = subprocess.run(["ostree", "admin", "set-default", target_id], check=False)
    if res.returncode != 0:
        print(f"[Kalacakra BE Error] 'ostree admin set-default' gagal (kode {res.returncode}).")
        sys.exit(res.returncode)
    msg = strings.get("be_activated", "Boot Environment '{id}' berhasil diaktifkan!").format(id=target_id)
    print(msg)
    print("Reboot komputer untuk masuk ke Boot Environment tersebut.")

def destroy_be(target_id: str):
    print(f"[Kalacakra BE] Menghapus pin / cadangan Boot Environment #{target_id}...")
    if not shutil.which("ostree"):
        print("[Kalacakra BE Error] 'ostree' tidak terpasang - TIDAK ada BE yang dihapus.")
        sys.exit(1)
    res = subprocess.run(["ostree", "admin", "unpin", target_id], check=False)
    if res.returncode != 0:
        print(f"[Kalacakra BE Error] 'ostree admin unpin' gagal (kode {res.returncode}).")
        sys.exit(res.returncode)
    print(f"[Kalacakra BE OK] Pin BE #{target_id} dilepas.")

def main():
    parser = argparse.ArgumentParser(
        prog="k-be",
        description="Kalacakra BE - FreeBSD bectl-style Boot Environment Manager"
    )
    subparsers = parser.add_subparsers(dest="command")
    subparsers.add_parser("list", help="List all boot environments")

    p_cr = subparsers.add_parser("create", help="Create / clone a new boot environment")
    p_cr.add_argument("name", help="Name or label for the new boot environment")

    p_ac = subparsers.add_parser("activate", help="Activate a boot environment for next boot")
    p_ac.add_argument("id", help="Deployment ID or index to activate")

    p_ds = subparsers.add_parser("destroy", help="Destroy / unpin a boot environment")
    p_ds.add_argument("id", help="Deployment ID to remove")

    args = parser.parse_args()

    if not args.command or args.command == "list":
        list_be()
    elif args.command == "create":
        create_be(args.name)
    elif args.command == "activate":
        activate_be(args.id)
    elif args.command == "destroy":
        destroy_be(args.id)

if __name__ == "__main__":
    main()
