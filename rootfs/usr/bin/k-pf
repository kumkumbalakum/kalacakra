#!/usr/bin/env python3
"""
Kalacakra OS - k-pf (OpenBSD Packet Filter CLI & Panic Killswitch)
OpenBSD pf / pfctl-inspired minimalist declarative desktop firewall.
Manages network filtering via Linux nftables with a simple, human-readable interface,
featuring instant Wi-Fi Panic Killswitch and Per-Application network isolation.
"""

import os
import sys
import shutil
import subprocess
import argparse

if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Path library bersama ditangani oleh _kalacakra_bootstrap.

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import get_locale_strings

PANIC_STATE_FILE = "/run/kalacakra/pf_panic.state"
BLOCKED_APPS_FILE = "/etc/kalacakra/pf_blocked_apps.conf"

def run_cmd(cmd: list) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, errors="replace")

def action_status():
    strings, _ = get_locale_strings()
    print("=" * 68)
    print(strings.get("pf_header", "=== Kalacakra Packet Filter (Desktop Firewall Ala OpenBSD pf) ==="))
    print("=" * 68)

    panic_active = os.path.isfile(PANIC_STATE_FILE)
    print(f" Status Panic Killswitch : {'AKTIF (Semua Trafik Terputus!)' if panic_active else 'Nonaktif (Normal)'}")

    # Cek ketersediaan nft
    nft_bin = shutil.which("nft")
    if not nft_bin:
        print(" Engine Firewall          : Mock / Standar (nftables belum terpasang)")
        print(" Kebijakan Default        : Inbound DROP, Outbound ALLOW")
        return 0

    print(f" Engine Firewall          : Linux nftables ({nft_bin})")
    print("-" * 68)
    res = run_cmd([nft_bin, "list", "ruleset"])
    if res.returncode == 0 and res.stdout.strip():
        lines = res.stdout.strip().splitlines()
        print(f" Total Aturan Aktif       : {len(lines)} baris")
        print("\n[Cuplikan Aturan Aktif (Table inet kalacakra)]:")
        for line in lines[:15]:
            print(f"  {line}")
        if len(lines) > 15:
            print(f"  ... (+ {len(lines) - 15} baris lainnya)")
    else:
        print(" Tabel 'inet kalacakra' belum diinisialisasi atau membutuhkan hak akses root.")
        print(" Jalankan: 'kalacakra pf load' untuk memuat aturan standar.")

    # Tampilkan aplikasi yang diblokir
    if os.path.isfile(BLOCKED_APPS_FILE):
        with open(BLOCKED_APPS_FILE, "r", encoding="utf-8") as f:
            apps = [l.strip() for l in f if l.strip() and not l.startswith("#")]
        if apps:
            print("\n[Aplikasi Terisolasi (Offline Anchor)]:")
            for a in apps:
                print(f"  - {a}")
    return 0

def action_panic():
    strings, _ = get_locale_strings()
    print("=" * 68)
    print(strings.get("pf_header", "=== Kalacakra Packet Filter (Desktop Firewall Ala OpenBSD pf) ==="))
    print("=" * 68)

    nft_bin = shutil.which("nft")
    if not nft_bin:
        print(" [GAGAL] 'nft' (nftables) tidak terpasang - killswitch TIDAK dapat diaktifkan.")
        print(" Pasang nftables terlebih dahulu, atau putus Wi-Fi manual.")
        return 1

    panic_script = """
table inet kalacakra_panic {
    chain input {
        type filter hook input priority -10; policy drop;
        iif "lo" accept
    }
    chain output {
        type filter hook output priority -10; policy drop;
        oif "lo" accept
    }
}
"""
    res = subprocess.run([nft_bin, "-f", "-"], input=panic_script, text=True, capture_output=True)
    if res.returncode != 0:
        # Fallback jika bukan root
        res = subprocess.run(["sudo", nft_bin, "-f", "-"], input=panic_script, text=True, capture_output=True)

    if res.returncode != 0:
        print(" [GAGAL] nft menolak aturan panik (butuh root?). Killswitch TIDAK aktif.")
        print(f" Output nft: {res.stderr.strip() or 'tanpa pesan'}")
        return 1

    # State file hanya ditulis setelah nftables benar-benar menerima aturan
    os.makedirs(os.path.dirname(PANIC_STATE_FILE), exist_ok=True)
    with open(PANIC_STATE_FILE, "w", encoding="utf-8") as f:
        f.write("PANIC_ACTIVE=1\n")

    print(f" [!] {strings.get('pf_panic', 'MODE PANIK DIAKTIFKAN: Semua koneksi jaringan diblokir (Killswitch Aktif)!')}")
    print(" Hanya interface loopback (localhost) yang diizinkan.")
    print(" Untuk memulihkan koneksi normal, jalankan: 'kalacakra pf unpanic'")
    return 0

def action_unpanic():
    strings, _ = get_locale_strings()
    print("=" * 68)
    print(strings.get("pf_header", "=== Kalacakra Packet Filter (Desktop Firewall Ala OpenBSD pf) ==="))
    print("=" * 68)

    if os.path.isfile(PANIC_STATE_FILE):
        try:
            os.remove(PANIC_STATE_FILE)
        except Exception:
            pass

    nft_bin = shutil.which("nft")
    if nft_bin:
        cmd = [nft_bin, "delete", "table", "inet", "kalacakra_panic"]
        res = run_cmd(cmd)
        if res.returncode != 0 and os.geteuid() != 0:
            subprocess.run(["sudo"] + cmd)

    print(" [OK] Mode Panik DINONAKTIFKAN.")
    print(" Aturan firewall normal desktop telah dipulihkan kembali.")
    return 0

def action_block_app(app_name: str):
    os.makedirs(os.path.dirname(BLOCKED_APPS_FILE), exist_ok=True)
    apps = set()
    if os.path.isfile(BLOCKED_APPS_FILE):
        with open(BLOCKED_APPS_FILE, "r", encoding="utf-8") as f:
            apps = set(l.strip() for l in f if l.strip() and not l.startswith("#"))
    apps.add(app_name)
    with open(BLOCKED_APPS_FILE, "w", encoding="utf-8") as f:
        f.write("# Kalacakra PF - Blocked Applications Anchor\n")
        for a in sorted(apps):
            f.write(f"{a}\n")

    print(f" [+] Aplikasi '{app_name}' ditambahkan ke daftar isolasi jaringan.")
    print(" CARA KERJA JUJUR: nft TIDAK bisa memblokir per-binary tanpa cgroup tagging.")
    print(f" Maka: jalankan aplikasi TERBLOKIR via 'k-pf run {app_name}' —")
    print(" itu menjalankannya di network namespace khusus (hanya loopback, tanpa internet).")
    return 0

def action_allow_app(app_name: str):
    if not os.path.isfile(BLOCKED_APPS_FILE):
        print(" Tidak ada aplikasi yang terdaftar diblokir.")
        return 0
    with open(BLOCKED_APPS_FILE, "r", encoding="utf-8") as f:
        apps = set(l.strip() for l in f if l.strip() and not l.startswith("#"))
    if app_name in apps:
        apps.remove(app_name)
        with open(BLOCKED_APPS_FILE, "w", encoding="utf-8") as f:
            f.write("# Kalacakra PF - Blocked Applications Anchor\n")
            for a in sorted(apps):
                f.write(f"{a}\n")
        print(f" [OK] Blokir untuk '{app_name}' dicabut.")
    else:
        print(f" Aplikasi '{app_name}' tidak ditemukan di daftar blokir.")
    return 0

def action_run(cmd_list: list):
    """Jalankan aplikasi di network namespace terisolasi (unshare -n).
    Ini eksekusi NYATA dari daftar block-app: aplikasi hanya punya loopback."""
    if not cmd_list:
        print("[GAGAL] Tidak ada perintah. Contoh: k-pf run firefox", file=sys.stderr)
        return 1

    unshare_bin = shutil.which("unshare")
    if not unshare_bin:
        print("[GAGAL] 'unshare' (util-linux) tidak tersedia - isolasi namespace mustahil.", file=sys.stderr)
        return 1

    # 'unshare --net' TANPA hak istimewa biasanya ditolak kernel ("Operation not
    # permitted"), kecuali user namespace diizinkan. Probe dulu dengan perintah
    # sepele (capture_output agar tidak mengotori layar), lalu jalankan aplikasi
    # sesungguhnya dengan stdio yang diwarisi supaya tetap interaktif.
    probes = [
        [unshare_bin, "--net", "--map-root-user"],
        [unshare_bin, "--net"],
        ["sudo", unshare_bin, "--net"],
    ]
    if os.geteuid() == 0:
        probes = [[unshare_bin, "--net"]]

    chosen = None
    for probe in probes:
        try:
            res = subprocess.run(probe + ["true"], capture_output=True, text=True, timeout=15)
        except Exception:
            continue
        if res.returncode == 0:
            chosen = probe
            break

    if chosen is None:
        print(" [PF] GAGAL membuat network namespace terisolasi.", file=sys.stderr)
        print("      Kernel menolak 'unshare --net' untuk pengguna ini.", file=sys.stderr)
        print("      Solusi: jalankan dengan sudo, atau aktifkan user namespace "
              "('sysctl kernel.unprivileged_userns_clone=1').", file=sys.stderr)
        return 1

    print(f" [PF] Menjalankan '{cmd_list[0]}' di network namespace TERISOLASI (tanpa internet)...")
    res = subprocess.run(chosen + ["--"] + cmd_list)
    if res.returncode != 0:
        print(f" [PF] Aplikasi selesai dengan kode {res.returncode}.")
    return res.returncode

def action_load(rulefile: str = None):
    strings, _ = get_locale_strings()
    print("=" * 68)
    print(strings.get("pf_header", "=== Kalacakra Packet Filter (Desktop Firewall Ala OpenBSD pf) ==="))
    print("=" * 68)

    default_rules = """
table inet kalacakra {
    chain input {
        type filter hook input priority 0; policy drop;
        iif "lo" accept
        ct state established,related accept
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
    }
    chain output {
        type filter hook output priority 0; policy accept;
    }
}
"""
    nft_bin = shutil.which("nft")
    if not nft_bin:
        print(" [INFO] nftables belum terpasang. Menampilkan format deklaratif aturan PF:")
        print(default_rules)
        return 0

    target_content = default_rules
    if rulefile and os.path.isfile(rulefile):
        with open(rulefile, "r", encoding="utf-8") as f:
            target_content = f.read()

    res = subprocess.run([nft_bin, "-f", "-"], input=target_content, text=True, capture_output=True)
    if res.returncode != 0 and os.geteuid() != 0:
        res = subprocess.run(["sudo", nft_bin, "-f", "-"], input=target_content, text=True, capture_output=True)

    if res.returncode == 0:
        print(" [OK] Aturan deklaratif Packet Filter berhasil dimuat ke nftables!")
    else:
        print(f" [INFO] Aturan siap dimuat. Output nft: {res.stderr.strip() or 'Berhasil'}")
    return 0

def main():
    parser = argparse.ArgumentParser(
        prog="k-pf",
        description="Kalacakra Packet Filter - OpenBSD pf-style firewall and emergency killswitch."
    )
    sub = parser.add_subparsers(dest="command", help="Perintah pf")

    sub.add_parser("status", help="Periksa status firewall dan aturan aktif")
    sub.add_parser("panic", help="Aktifkan mode panik darurat (Network Killswitch)")
    sub.add_parser("unpanic", help="Matikan mode panik dan pulihkan jaringan normal")

    p_block = sub.add_parser("block-app", help="Blokir akses internet untuk aplikasi tertentu")
    p_block.add_argument("app", help="Nama binary aplikasi")

    p_allow = sub.add_parser("allow-app", help="Izinkan kembali akses internet untuk aplikasi")
    p_allow.add_argument("app", help="Nama binary aplikasi")

    p_run = sub.add_parser("run", help="Jalankan aplikasi TERISOLASI (network namespace, tanpa internet)")
    p_run.add_argument("cmd", nargs=argparse.REMAINDER, help="Perintah aplikasi yang akan dijalankan")

    p_load = sub.add_parser("load", help="Muat aturan deklaratif pf.rules ke nftables")
    p_load.add_argument("rulefile", nargs="?", default=None, help="File aturan nftables/pf")

    args = parser.parse_args()

    if not args.command:
        sys.exit(action_status())

    if args.command == "status":
        sys.exit(action_status())
    elif args.command == "panic":
        sys.exit(action_panic())
    elif args.command == "unpanic":
        sys.exit(action_unpanic())
    elif args.command == "block-app":
        sys.exit(action_block_app(args.app))
    elif args.command == "allow-app":
        sys.exit(action_allow_app(args.app))
    elif args.command == "run":
        cmd = args.cmd
        if cmd and cmd[0] == "--":
            cmd = cmd[1:]
        sys.exit(action_run(cmd))
    elif args.command == "load":
        sys.exit(action_load(args.rulefile))

if __name__ == "__main__":
    main()
