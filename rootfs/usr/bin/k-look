#!/usr/bin/env python3
"""
Kalacakra OS - k-look
Kalacakra Look - the flagship one-command desktop identity / "ricing" manager.

Terapkan tampilan desktop (tema KDE, warna, wallpaper, terminal, fastfetch,
ikon, kursor) secara atomik dari sebuah preset, lalu bisa di-rollback penuh.
Dibuat untuk menjadi fitur ikonik Kalacakra: cantik, bisa di-demo, dan aman
karena seluruh perubahan dibungkus snapshot sebelum diterapkan.

Catatan jujur:
- Tool ini menulis ke direktori konfigurasi USER (XDG), bukan ke root host
  yang immutable. Tidak ada yang di-"layer" ke image; ini murni kustomisasi
  home directory, jadi konsisten dengan model immutable.
- Bila prasyarat opsional (plasma-apply-*, kwriteconfig6, lookandfeeltool,
  gsettings) absen, tool melewatinya dengan jujur dan menandainya SKIP, bukan
  mengklaim sukses.
"""

import os
import sys
import json
import shutil
import argparse
import subprocess
import datetime

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))

def presets_dir() -> str:
    """Lokasi direktori preset Look (bisa dioverride via env untuk test)."""
    env = os.environ.get("KALACAKRA_LOOK_PRESETS_DIR")
    if env and os.path.isdir(env):
        return env
    for cand in (
        os.path.abspath(os.path.join(SCRIPT_DIR, "..", "share", "kalacakra", "look", "presets")),
        "/usr/share/kalacakra/look/presets",
    ):
        if os.path.isdir(cand):
            return cand
    return os.path.abspath(os.path.join(SCRIPT_DIR, "..", "share", "kalacakra", "look", "presets"))


CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
DATA_HOME = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
LOOK_STATE_DIR = os.path.join(DATA_HOME, "kalacakra", "look")
# Preset komunitas milik user (tidak mengubah image immutable).
USER_PRESETS_DIR = os.path.join(DATA_HOME, "kalacakra", "look", "presets")
# Skema minimal yang harus dimiliki preset komunitas agar valid.
REQUIRED_PRESET_FIELDS = ("id", "name")
KNOWN_PRESET_KEYS = {
    "id", "name", "description", "plasma_theme", "color_scheme", "wallpaper",
    "cursor", "icons", "fonts", "terminal", "terminal_colors", "fastfetch", "starship",
}
LOOK_ACTIVE_FILE = os.path.join(LOOK_STATE_DIR, "active.json")


# ---------------------------------------------------------------------------
# Utilitas
# ---------------------------------------------------------------------------
def find_bin(name: str) -> str:
    candidates = [f"/usr/bin/{name}", os.path.join(SCRIPT_DIR, name)]
    for c in candidates:
        if os.path.isfile(c):
            return c
    return name


def have(name: str) -> bool:
    return shutil.which(name) is not None


def list_presets() -> list[dict]:
    """Kembalikan daftar preset yang valid, menggabungkan preset bawaan (sistem)
    dengan preset komunitas milik user. Preset user menang bila id sama."""
    result = []
    seen = set()
    # User presets lebih dulu agar bisa menimpa preset bawaan dengan id sama.
    for d in (USER_PRESETS_DIR, presets_dir()):
        if not os.path.isdir(d):
            continue
        for fname in sorted(os.listdir(d)):
            if not fname.endswith(".json"):
                continue
            path = os.path.join(d, fname)
            try:
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
            except (OSError, json.JSONDecodeError):
                continue
            if not isinstance(data, dict):
                continue
            data.setdefault("id", fname[:-5])
            if data["id"] in seen:
                continue
            seen.add(data["id"])
            data["__path__"] = path
            result.append(data)
    return result


def find_preset(preset_id: str):
    for p in list_presets():
        if p.get("id") == preset_id:
            return p
    return None


# ---------------------------------------------------------------------------
# Penerap langkah-langkah preset
# ---------------------------------------------------------------------------
def _write_kde_config(rel_config_path: str, group: str, key: str, value: str) -> bool:
    """Tulis nilai ke file konfigurasi KDE (kwriteconfig6 bila ada, jika tidak
    tulis INI sederhana secara manual). Mengembalikan True bila berubah."""
    target = os.path.join(CONFIG_HOME, rel_config_path)
    if have("kwriteconfig6"):
        res = subprocess.run(
            ["kwriteconfig6", "--file", target, "--group", group, "--key", key, value],
            capture_output=True, text=True,
        )
        return res.returncode == 0
    if have("kwriteconfig5"):
        res = subprocess.run(
            ["kwriteconfig5", "--file", target, "--group", group, "--key", key, value],
            capture_output=True, text=True,
        )
        return res.returncode == 0

    # Fallback manual: sisipkan/perbarui [group] key=value di file INI.
    try:
        os.makedirs(os.path.dirname(target), exist_ok=True)
        lines = []
        if os.path.isfile(target):
            with open(target, "r", encoding="utf-8") as f:
                lines = f.read().splitlines()
        out, in_group, done = [], False, False
        for line in lines:
            stripped = line.strip()
            if stripped.startswith("[") and stripped.endswith("]"):
                if in_group and not done:
                    out.append(f"{key}={value}")
                    done = True
                in_group = (stripped == f"[{group}]")
            out.append(line)
        if in_group and not done:
            out.append(f"{key}={value}")
            done = True
        if not done:
            if out and out[-1].strip():
                out.append("")
            out.append(f"[{group}]")
            out.append(f"{key}={value}")
        with open(target, "w", encoding="utf-8") as f:
            f.write("\n".join(out) + "\n")
        return True
    except OSError:
        return False


def apply_plasma_theme(theme: str) -> tuple[str, str]:
    """Terapkan global desktop look & feel (Plasma 6)."""
    if have("plasma-apply-lookandfeel"):
        res = subprocess.run(["plasma-apply-lookandfeel", "-a", theme],
                             capture_output=True, text=True)
        if res.returncode == 0:
            return "OK", f"look-and-feel: {theme}"
        return "WARN", f"plasma-apply-lookandfeel gagal: {res.stderr.strip()[:80]}"
    if have("lookandfeeltool"):
        res = subprocess.run(["lookandfeeltool", "-a", theme], capture_output=True, text=True)
        if res.returncode == 0:
            return "OK", f"look-and-feel: {theme}"
        return "WARN", f"lookandfeeltool gagal: {res.stderr.strip()[:80]}"
    return "SKIP", "plasma-apply-lookandfeel/lookandfeeltool tidak terpasang"


# Palet warna RGB asli untuk setiap preset Nusantara (WindowBG, WindowFG, ViewBG, AccentRGB)
PRESET_PALETTES = {
    "mandala-cyberpunk": {"win_bg": "22,7,38", "win_fg": "242,235,255", "view_bg": "12,3,24", "accent": "255,47,214"},
    "nusantara-bronze":  {"win_bg": "246,238,226", "win_fg": "38,24,12", "view_bg": "255,250,242", "accent": "201,138,60"},
    "obsidian-minimal":  {"win_bg": "14,16,20", "win_fg": "228,232,238", "view_bg": "8,9,12", "accent": "139,147,161"},
    "aurora-borealis":   {"win_bg": "11,26,36", "win_fg": "230,252,248", "view_bg": "5,15,22", "accent": "77,255,208"},
    "kraton-gold":       {"win_bg": "20,15,6", "win_fg": "255,242,204", "view_bg": "12,9,3", "accent": "224,180,74"},
    "batik-parang":      {"win_bg": "248,240,225", "win_fg": "46,29,16", "view_bg": "255,251,244", "accent": "184,132,64"},
    "rimba-sumatra":     {"win_bg": "11,31,22", "win_fg": "230,250,238", "view_bg": "6,19,13", "accent": "29,185,120"},
    "jakarta-neon":      {"win_bg": "12,18,42", "win_fg": "234,242,255", "view_bg": "6,10,26", "accent": "56,189,248"},
    "bali-senja":        {"win_bg": "32,12,36", "win_fg": "255,236,224", "view_bg": "18,7,24", "accent": "255,112,67"},
    "segara-raja":       {"win_bg": "6,34,46", "win_fg": "224,252,250", "view_bg": "3,19,28", "accent": "6,182,212"},
}


def write_kde_colorscheme(preset: dict | None) -> str:
    """Bangun berkas skema warna KDE asli (~/.local/share/color-schemes/Kalacakra-<id>.colors)
    dan tulis AccentColor ke kdeglobals agar warna tema benar-benar khas."""
    if not preset:
        return ""
    pid = preset.get("id", "custom")
    name = preset.get("name", pid)
    pal = PRESET_PALETTES.get(
        pid,
        {"win_bg": "20,22,28", "win_fg": "236,240,244", "view_bg": "12,14,18", "accent": "56,189,248"},
    )
    scheme_id = f"Kalacakra-{pid}"
    schemes_dir = os.path.join(DATA_HOME, "color-schemes")
    out_file = os.path.join(schemes_dir, f"{scheme_id}.colors")
    content = (
        f"[General]\n"
        f"ColorScheme={scheme_id}\n"
        f"Name=Kalacakra {name}\n\n"
        f"[Colors:Window]\n"
        f"BackgroundNormal={pal['win_bg']}\n"
        f"ForegroundNormal={pal['win_fg']}\n\n"
        f"[Colors:View]\n"
        f"BackgroundNormal={pal['view_bg']}\n"
        f"ForegroundNormal={pal['win_fg']}\n\n"
        f"[Colors:Button]\n"
        f"BackgroundNormal={pal['win_bg']}\n"
        f"ForegroundNormal={pal['win_fg']}\n"
        f"DecorationFocus={pal['accent']}\n\n"
        f"[Colors:Selection]\n"
        f"BackgroundNormal={pal['accent']}\n"
        f"ForegroundNormal={pal['view_bg']}\n\n"
        f"[Colors:Header]\n"
        f"BackgroundNormal={pal['win_bg']}\n"
        f"ForegroundNormal={pal['win_fg']}\n"
    )
    try:
        os.makedirs(schemes_dir, exist_ok=True)
        with open(out_file, "w", encoding="utf-8") as f:
            f.write(content)
        _write_kde_config("kdeglobals", "General", "AccentColor", pal["accent"])
        return out_file
    except OSError:
        return ""


def apply_color_scheme(scheme: str, preset: dict | None = None) -> tuple[str, str]:
    custom_file = write_kde_colorscheme(preset)
    if have("plasma-apply-colorscheme"):
        res = subprocess.run(["plasma-apply-colorscheme", scheme], capture_output=True, text=True)
        if res.returncode == 0:
            extra = f" + {os.path.basename(custom_file)}" if custom_file else ""
            return "OK", f"color scheme: {scheme}{extra}"
        return "WARN", f"color scheme gagal: {res.stderr.strip()[:80]}"
    # Fallback: tulis skema warna ke config kdeglobals.
    ok = _write_kde_config("kdeglobals", "General", "ColorScheme", scheme)
    extra = f" + {os.path.basename(custom_file)}" if custom_file else ""
    return ("OK", f"color scheme (config): {scheme}{extra}") if ok else ("WARN", "gagal tulis color scheme")


def apply_wallpaper(image: str) -> tuple[str, str]:
    if not image:
        return "SKIP", "tidak ada wallpaper"
    # Wallpaper bisa berupa path absolut atau nama file di dalam preset bundle.
    path = image
    if not os.path.isabs(path):
        local = os.path.join(presets_dir(), "..", "wallpapers", image)
        if os.path.isfile(local):
            path = os.path.abspath(local)
    if have("plasma-apply-wallpaperimage") and os.path.isfile(path):
        res = subprocess.run(["plasma-apply-wallpaperimage", path], capture_output=True, text=True)
        if res.returncode == 0:
            return "OK", f"wallpaper: {os.path.basename(path)}"
        return "WARN", f"wallpaper gagal: {res.stderr.strip()[:80]}"
    if not os.path.isfile(path):
        return "WARN", f"wallpaper hilang: {path}"
    # Fallback: catat di config desktop (Plasma membaca ini saat login).
    ok = _write_kde_config("plasma-org.kde.plasma.desktop-appletsrc",
                           "Containments][1][Wallpaper][org.kde.image][General",
                           "Image", f"file://{path}")
    return ("OK", f"wallpaper (config): {os.path.basename(path)}") if ok else ("WARN", "gagal set wallpaper")


def apply_terminal_theme(theme_name: str, colors: dict | None) -> tuple[str, str]:
    """Tulis profil terminal ramah (Ptyxis/Konsole) — fallback ke config INI."""
    if not theme_name and not colors:
        return "SKIP", "tidak ada tema terminal"
    # Konfigurasi terminal KDE (Konsole) profil default.
    changed = False
    if colors:
        for key, val in colors.items():
            if _write_kde_config("konsolerc", "Appearance", key, val):
                changed = True
    if theme_name:
        if _write_kde_config("konsolerc", "Desktop Entry", "DefaultProfile", theme_name):
            changed = True
    return ("OK", f"terminal: {theme_name or 'colors'}") if changed else ("WARN", "terminal tidak berubah")


def apply_cursor(theme: str) -> tuple[str, str]:
    if not theme:
        return "SKIP", "tidak ada kursor"
    ok = _write_kde_config("kcminputrc", "Mouse", "cursorTheme", theme)
    return ("OK", f"cursor: {theme}") if ok else ("WARN", "gagal set kursor")


def apply_icons(theme: str) -> tuple[str, str]:
    if not theme:
        return "SKIP", "tidak ada ikon"
    ok = _write_kde_config("kdeglobals", "Icons", "Theme", theme)
    return ("OK", f"icons: {theme}") if ok else ("WARN", "gagal set ikon")


def apply_fonts(fonts: dict | None) -> tuple[str, str]:
    if not fonts:
        return "SKIP", "tidak ada font"
    changed = False
    for key, val in fonts.items():
        if _write_kde_config("kdeglobals", "General", key, val):
            changed = True
    return ("OK", "font diperbarui") if changed else ("WARN", "gagal set font")


def apply_fastfetch_theme(preset: dict) -> tuple[str, str]:
    """Tulis config fastfetch kustom agar tema terasa sampai ke terminal art."""
    ff = preset.get("fastfetch")
    if not ff:
        return "SKIP", "tidak ada tema fastfetch"
    target = os.path.join(CONFIG_HOME, "fastfetch", "config.jsonc")
    try:
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "w", encoding="utf-8") as f:
            if isinstance(ff, dict):
                json.dump(ff, f, indent=2, ensure_ascii=False)
            else:
                f.write(str(ff))
        return "OK", "fastfetch: tema diterapkan"
    except OSError as e:
        return "WARN", f"fastfetch gagal: {e}"


def apply_starship_theme(preset: dict) -> tuple[str, str]:
    star = preset.get("starship")
    if not star:
        return "SKIP", "tidak ada tema starship"
    target = os.path.join(CONFIG_HOME, "starship.toml")
    try:
        with open(target, "a", encoding="utf-8") as f:
            f.write("\n# --- Kalacakra Look ---\n")
            if isinstance(star, dict):
                for k, v in star.items():
                    f.write(f'{k} = "{v}"\n')
            else:
                f.write(str(star) + "\n")
        return "OK", "starship prompt diperbarui"
    except OSError as e:
        return "WARN", f"starship gagal: {e}"


APPLIERS = {
    "plasma_theme": lambda v, p: apply_plasma_theme(v),
    "color_scheme": lambda v, p: apply_color_scheme(v, p),
    "wallpaper": lambda v, p: apply_wallpaper(v),
    "cursor": lambda v, p: apply_cursor(v),
    "icons": lambda v, p: apply_icons(v),
    "fonts": lambda v, p: apply_fonts(v),
    "terminal": lambda v, p: apply_terminal_theme(v, p.get("terminal_colors")),
    "fastfetch": lambda v, p: apply_fastfetch_theme(p),
    "starship": lambda v, p: apply_starship_theme(p),
}


# ---------------------------------------------------------------------------
# Riwayat / rollback sederhana (self-contained, tanpa snapshot root)
# ---------------------------------------------------------------------------
def _now_stamp() -> str:
    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")


def _files_we_touch() -> list[str]:
    """Daftar file konfigurasi yang mungkin diubah tool ini (relatif CONFIG_HOME)."""
    return [
        "kdeglobals",
        "konsolerc",
        "kcminputrc",
        "starship.toml",
        "fastfetch/config.jsonc",
        "plasma-org.kde.plasma.desktop-appletsrc",
    ]


def make_backup() -> str:
    """Salin file konfigurasi yang akan disentuh ke folder riwayat."""
    stamp = _now_stamp()
    dest_dir = os.path.join(LOOK_STATE_DIR, "history", stamp)
    os.makedirs(dest_dir, exist_ok=True)
    for rel in _files_we_touch():
        src = os.path.join(CONFIG_HOME, rel)
        if os.path.isfile(src):
            dst = os.path.join(dest_dir, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            try:
                shutil.copy2(src, dst)
            except OSError:
                pass
    return dest_dir


def save_active(preset: dict, history_dir: str) -> None:
    os.makedirs(LOOK_STATE_DIR, exist_ok=True)
    data = {
        "id": preset.get("id"),
        "name": preset.get("name"),
        "applied_at": datetime.datetime.now().isoformat(timespec="seconds"),
        "history": history_dir,
    }
    try:
        with open(LOOK_ACTIVE_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
    except OSError:
        pass


def get_active() -> dict | None:
    if not os.path.isfile(LOOK_ACTIVE_FILE):
        return None
    try:
        with open(LOOK_ACTIVE_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return None


def rollback() -> int:
    """Kembalikan konfigurasi ke snapshot riwayat terakhir."""
    active = get_active()
    history = None
    if active and active.get("history") and os.path.isdir(active["history"]):
        history = active["history"]
    else:
        hist_root = os.path.join(LOOK_STATE_DIR, "history")
        if os.path.isdir(hist_root):
            entries = sorted(
                (os.path.join(hist_root, d) for d in os.listdir(hist_root)),
                reverse=True,
            )
            for e in entries:
                if os.path.isdir(e):
                    history = e
                    break
    if not history:
        print("[k-look Error] Tidak ada riwayat Look untuk di-rollback.")
        return 1

    restored = 0
    for rel in _files_we_touch():
        src = os.path.join(history, rel)
        dst = os.path.join(CONFIG_HOME, rel)
        if os.path.isfile(src):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            try:
                shutil.copy2(src, dst)
                restored += 1
            except OSError:
                pass
    print(f"[k-look] Rollback selesai. {restored} berkas konfigurasi dipulihkan dari {os.path.basename(history)}.")
    print("         (Logout / login ulang agar Plasma memuat tampilan lama.)")
    if os.path.isfile(LOOK_ACTIVE_FILE):
        try:
            os.remove(LOOK_ACTIVE_FILE)
        except OSError:
            pass
    return 0


# ---------------------------------------------------------------------------
# Screenshot / berbagi
# ---------------------------------------------------------------------------
def take_screenshot(preset: dict) -> tuple[str, str]:
    """Ambil screenshot desktop via grim (Wayland). Jujur jika tool absen."""
    if not have("grim"):
        return "SKIP", "grim tidak terpasang (screenshot dilewati)"
    shots_dir = os.path.join(os.path.expanduser("~"), "Pictures", "Kalacakra")
    os.makedirs(shots_dir, exist_ok=True)
    fname = f"kalacakra-look-{preset.get('id', 'theme')}-{_now_stamp()}.png"
    out_path = os.path.join(shots_dir, fname)
    res = subprocess.run(["grim", out_path], capture_output=True, text=True)
    if res.returncode != 0:
        return "WARN", f"grim gagal: {res.stderr.strip()[:80]}"
    return "OK", out_path


def build_share_caption(preset: dict) -> str:
    """Susun caption siap-tempel untuk r/unixporn & media sosial."""
    name = preset.get("name", preset.get("id", "Look"))
    desc = preset.get("description", "")
    return (
        f"{name} - Kalacakra OS\n"
        f"{desc}\n"
        f"One command: `kalacakra look {preset.get('id')}`  |  #KalacakraOS #ricing #Linux"
    )


# ---------------------------------------------------------------------------
# Perintah
# ---------------------------------------------------------------------------
def cmd_list(presets: list[dict]) -> int:
    active = get_active()
    active_id = active.get("id") if active else None
    print("=== Kalacakra Look - Preset Tersedia ===")
    if not presets:
        print(f"  (tidak ada preset di {presets_dir()})")
        return 0
    for i, p in enumerate(presets, 1):
        mark = " *" if p.get("id") == active_id else "  "
        print(f"{mark} [{i}] {p.get('id'):<16} {p.get('name', '')}")
        if p.get("description"):
            print(f"       {p['description']}")
    print()
    print("Terapkan:  kalacakra look apply <id>")
    print("Interaktif: kalacakra look pick  |  GUI: kalacakra look gui")
    return 0


def detect_gui_backend() -> str | None:
    """Deteksi backend dialog GUI (kdialog/zenity). Jujur: butuh sesi tampilan
    (DISPLAY / WAYLAND_DISPLAY) kecuali dioverride KALACAKRA_FORCE_GUI=1."""
    has_display = bool(
        os.environ.get("DISPLAY")
        or os.environ.get("WAYLAND_DISPLAY")
        or os.environ.get("KALACAKRA_FORCE_GUI") == "1"
    )
    if not has_display:
        return None
    if have("kdialog"):
        return "kdialog"
    if have("zenity"):
        return "zenity"
    return None


def cmd_gui(presets: list[dict], do_shot: bool = False) -> int:
    """Pemilih tema grafis via kdialog (KDE) atau zenity (GTK).
    Fallback jujur ke TUI bila kdialog/zenity atau sesi grafis tidak tersedia."""
    if not presets:
        print("[k-look] Tidak ada preset tersedia.")
        return 1
    backend = detect_gui_backend()
    if not backend:
        print("[k-look] Dialog GUI (kdialog/zenity) atau sesi tampilan tidak tersedia.")
        if sys.stdin.isatty():
            print("[k-look] Beralih ke pemilih terminal interaktif (TUI)...")
            return cmd_pick(presets)
        return 1

    active = get_active()
    active_id = active.get("id") if active else None

    if backend == "kdialog":
        cmd = [
            "kdialog",
            "--title", "Kalacakra Look - Pemilih Tema",
            "--radiolist", "Pilih identitas visual desktop Kalacakra OS:",
        ]
        for i, p in enumerate(presets):
            pid = p.get("id", "")
            label = f"{p.get('name', pid)} - {p.get('description', '')}"
            is_sel = (pid == active_id) if active_id else (i == 0)
            cmd.extend([pid, label, "on" if is_sel else "off"])
    else:
        cmd = [
            "zenity", "--list", "--radiolist",
            "--title=Kalacakra Look - Pemilih Tema",
            "--text=Pilih identitas visual desktop Kalacakra OS:",
            "--column=", "--column=ID", "--column=Tema", "--column=Deskripsi",
            "--width=720", "--height=460",
        ]
        for i, p in enumerate(presets):
            pid = p.get("id", "")
            is_sel = (pid == active_id) if active_id else (i == 0)
            cmd.extend(["TRUE" if is_sel else "FALSE", pid, p.get("name", pid), p.get("description", "")])

    res = subprocess.run(cmd, capture_output=True, text=True)
    chosen = res.stdout.strip()
    if res.returncode != 0 or not chosen:
        print("Dibatalkan.")
        return 0

    rc = cmd_apply(chosen, do_shot=do_shot)
    if rc == 0 and backend == "kdialog":
        subprocess.run(
            ["kdialog", "--title", "Kalacakra Look", "--passivepopup",
             f"Tema '{chosen}' berhasil diterapkan.", "4"],
            capture_output=True, text=True,
        )
    return rc


def cmd_pick(presets: list[dict]) -> int:
    """Pemilih tema interaktif sederhana (TUI berbasis nomor)."""
    if not presets:
        print("[k-look] Tidak ada preset. Impor dulu: kalacakra look import <berkas.json> --install")
        return 1
    active = get_active()
    active_id = active.get("id") if active else None
    print()
    print("=" * 60)
    print("  Kalacakra Look - Pemilih Tema")
    print("=" * 60)
    for i, p in enumerate(presets, 1):
        mark = "  <- aktif" if p.get("id") == active_id else ""
        print(f"  [{i}] {p.get('name', p.get('id')):<22}{mark}")
        if p.get("description"):
            print(f"       {p['description']}")
    print("  [0] Batal / Keluar")
    print("=" * 60)

    try:
        choice = input("Pilih tema [0-%d]: " % len(presets)).strip()
    except (EOFError, KeyboardInterrupt):
        print("\nDibatalkan.")
        return 0
    if choice in ("0", ""):
        print("Dibatalkan.")
        return 0
    try:
        idx = int(choice) - 1
        if not (0 <= idx < len(presets)):
            raise ValueError
    except ValueError:
        print("[k-look Error] Pilihan tidak valid.")
        return 1
    pid = presets[idx].get("id")
    shot = False
    try:
        ans = input("Ambil screenshot + caption setelah menerapkan? [y/N]: ").strip().lower()
        shot = ans in ("y", "ya", "yes")
    except (EOFError, KeyboardInterrupt):
        pass
    return cmd_apply(pid, do_shot=shot)


def cmd_show(preset_id: str) -> int:
    p = find_preset(preset_id)
    if not p:
        print(f"[k-look Error] Preset '{preset_id}' tidak ditemukan. Jalankan 'kalacakra look'.")
        return 1
    print(f"=== {p.get('name', preset_id)} ===")
    for k in ("description", "plasma_theme", "color_scheme", "wallpaper",
              "cursor", "icons", "terminal"):
        if p.get(k):
            print(f"  {k:<14}: {p[k]}")
    return 0


def cmd_apply(preset_id: str, do_shot: bool, dry_run: bool = False) -> int:
    p = find_preset(preset_id)
    if not p:
        print(f"[k-look Error] Preset '{preset_id}' tidak ditemukan.")
        print("   Jalankan 'kalacakra look' untuk melihat daftar preset.")
        return 1

    if dry_run:
        return _render_dry_run(p)

    print(f"[k-look] Menerapkan tampilan '{p.get('name', preset_id)}'...")
    # Snapshot konfigurasi sebelum berubah -> aman & bisa di-rollback.
    history = make_backup()
    print(f"[k-look] Cadangan konfigurasi: {history}")

    results = []
    for key, applier in APPLIERS.items():
        # Applier preset-level (fastfetch/starship) menerima (value, preset);
        # value bisa None karena mereka membaca seluruh dict preset.
        val = None if key in ("fastfetch", "starship") else p.get(key)
        if key in ("fastfetch", "starship"):
            if not p.get(key):
                continue
        elif not val:
            continue
        status, msg = applier(val, p)
        results.append((key, status, msg))
        tag = {"OK": "\033[32m OK \033[0m", "WARN": "\033[33mWARN\033[0m",
               "SKIP": "\033[36mSKIP\033[0m"}.get(status, status)
        print(f"  [{tag}] {key:<14}: {msg}")

    save_active(p, history)
    applied = sum(1 for _, s, _ in results if s == "OK")
    skipped = sum(1 for _, s, _ in results if s == "SKIP")
    warned = sum(1 for _, s, _ in results if s == "WARN")
    print(f"\n[k-look] Selesai: {applied} diterapkan, {skipped} dilewati, {warned} peringatan.")
    if skipped:
        print("         (Yang dilewati berarti prasyarat Plasma belum ada di sistem ini -")
        print("          lihat catatan jujur: tool tidak memalsukan keberhasilan.)")
    print("         Logout lalu login ulang agar Plasma memuat tampilan baru.")

    if do_shot:
        status, info = take_screenshot(p)
        if status == "OK":
            print(f"\n[k-look] Screenshot tersimpan: {info}")
            print("[k-look] Caption siap-tempel untuk r/unixporn / sosial media:\n")
            print("---8<---")
            print(build_share_caption(p))
            print("---8<---")
        else:
            print(f"\n[k-look] {info}")
    return 0


def _render_dry_run(p: dict) -> int:
    """Tampilkan persis apa yang AKAN berubah tanpa menyentuh sistem."""
    print(f"[k-look] DRY-RUN untuk '{p.get('name', p.get('id'))}' - tidak ada berkas yang diubah.\n")
    steps = []
    for key in APPLIERS:
        if key in ("fastfetch", "starship"):
            if p.get(key):
                steps.append((key, "akan menulis config preset-level"))
            continue
        val = p.get(key)
        if not val:
            continue
        if key == "wallpaper":
            path = _resolve_wallpaper_path(val)
            steps.append((key, f"-> {path}" + ("" if os.path.isfile(path) else "  [BERKAS HILANG]")))
        elif key == "terminal":
            steps.append((key, f"tema={val}, colors={bool(p.get('terminal_colors'))}"))
        elif key == "fonts":
            steps.append((key, "; ".join(f"{k}={v.split(',')[0]}" for k, v in val.items())))
        else:
            steps.append((key, str(val)))

    print(f"  Target config dir : {CONFIG_HOME}")
    print(f"  Berkas yang mungkin disentuh ({len(_files_we_touch())}):")
    for rel in _files_we_touch():
        exists = "ada" if os.path.lexists(os.path.join(CONFIG_HOME, rel)) else "belum ada"
        print(f"      - {rel}  ({exists})")
    print("\n  Langkah yang akan dijalankan:")
    for key, desc in steps:
        print(f"      [{key:<14}] {desc}")
    print("\n  Prasyarat terdeteksi:")
    for tool in ("plasma-apply-lookandfeel", "plasma-apply-colorscheme",
                 "plasma-apply-wallpaperimage", "kwriteconfig6", "grim"):
        print(f"      {'OK  ' if have(tool) else 'ABSN'}  {tool}")
    print("\n[k-look] Jalankan tanpa --dry-run untuk menerapkan.")
    return 0


def _resolve_wallpaper_path(image: str) -> str:
    if not image:
        return ""
    if os.path.isabs(image):
        return image
    local = os.path.join(presets_dir(), "..", "wallpapers", image)
    if os.path.isfile(local):
        return os.path.abspath(local)
    return image


def cmd_rollback() -> int:
    return rollback()


def cmd_current() -> int:
    active = get_active()
    if not active:
        print("Tidak ada preset Look aktif (tampilan default/bawaan).")
        return 0
    print(f"Tampilan aktif: {active.get('name')} ({active.get('id')})")
    print(f"Diterapkan pada: {active.get('applied_at')}")
    return 0


def cmd_share(preset_id: str | None) -> int:
    if preset_id:
        p = find_preset(preset_id)
    else:
        active = get_active()
        p = find_preset(active.get("id")) if active else None
    if not p:
        print("[k-look Error] Tidak ada preset aktif/dikenali untuk dibagikan.")
        return 1
    print("---8<--- Salin mulai baris berikut ---8<---")
    print(build_share_caption(p))
    print("---8<--- Selesai ---8<---")
    return 0


def validate_preset(data: dict) -> tuple[bool, list]:
    """Validasi sederhana struktur preset. Mengembalikan (valid, daftar_masalah)."""
    problems = []
    if not isinstance(data, dict):
        return False, ["preset harus berupa objek JSON (dict)"]
    for field in REQUIRED_PRESET_FIELDS:
        if not data.get(field):
            problems.append(f"field wajib '{field}' kosong/tidak ada")
    unknown = set(data) - KNOWN_PRESET_KEYS
    if unknown:
        problems.append(f"key tak dikenal (diabaikan): {sorted(unknown)}")
    # Wallpaper (bila ada & bukan URL/absolut) harus dapat dipastikan keberadaannya.
    wp = data.get("wallpaper")
    if wp and not os.path.isabs(wp) and not wp.startswith(("http://", "https://")):
        if not os.path.isfile(os.path.join(presets_dir(), "..", "wallpapers", wp)):
            problems.append(f"wallpaper '{wp}' tidak ditemukan (preset tetap bisa dipakai tanpa wallpaper)")
    return (not [p for p in problems if "wajib" in p]), problems


def cmd_import(source: str, install: bool) -> int:
    """Impor preset komunitas dari berkas JSON lokal atau URL. Default: validasi
    + preview (dry). Dengan --install, salin ke direktori preset user."""
    import json
    import urllib.request

    raw = None
    if source.startswith(("http://", "https://")):
        try:
            with urllib.request.urlopen(source, timeout=15) as resp:
                raw = resp.read().decode("utf-8")
        except Exception as e:
            print(f"[k-look Error] Gagal mengunduh preset dari '{source}': {e}")
            return 1
    else:
        if not os.path.isfile(source):
            print(f"[k-look Error] Berkas preset tidak ditemukan: {source}")
            return 1
        try:
            with open(source, "r", encoding="utf-8") as f:
                raw = f.read()
        except OSError as e:
            print(f"[k-look Error] Gagal membaca '{source}': {e}")
            return 1

    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"[k-look Error] JSON preset tidak valid: {e}")
        return 1

    valid, problems = validate_preset(data)
    print(f"[k-look] Preset: {data.get('name', '(tanpa nama)')} ({data.get('id', '?')})")
    if problems:
        for pr in problems:
            print(f"         perhatian: {pr}")
    if not valid:
        print("[k-look Error] Preset tidak memenuhi skema minimal (id & name wajib).")
        return 1

    if not install:
        print("[k-look] Validasi selesai. Jalankan dengan --install untuk memasang preset ini.")
        print("         Preset komunitas disimpan di:")
        print(f"             {USER_PRESETS_DIR}")
        return 0

    os.makedirs(USER_PRESETS_DIR, exist_ok=True)
    out = os.path.join(USER_PRESETS_DIR, f"{data['id']}.json")
    if os.path.exists(out):
        print(f"[k-look Error] Preset '{data['id']}' sudah ada di {out}. Hapus dulu bila ingin menimpa.")
        return 1
    try:
        with open(out, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
    except OSError as e:
        print(f"[k-look Error] Gagal menulis preset: {e}")
        return 1
    print(f"[k-look] Preset '{data['id']}' terpasang di {out}.")
    print(f"[k-look] Terapkan dengan: kalacakra look apply {data['id']}")
    return 0


def resolve_roda_waktu_preset(hour: int | None = None) -> tuple[str, str, int]:
    """Tentukan preset berdasarkan siklus jam harian Nusantara (Roda Waktu).
    Mengembalikan (preset_id, nama_fase_waktu, jam_dipakai)."""
    if hour is None:
        hour = datetime.datetime.now().hour
    hour = int(hour) % 24
    if 6 <= hour < 11:
        return "batik-parang", "Pagi / Fajar (Hangat & Produktif)", hour
    if 11 <= hour < 15:
        return "segara-raja", "Siang / Terik (Segar & Fokus)", hour
    if 15 <= hour < 19:
        return "bali-senja", "Senja / Sore (Lembayung Keemasan)", hour
    if 19 <= hour < 22:
        return "kraton-gold", "Malam / Petang (Elegan & Tenang)", hour
    return "mandala-cyberpunk", "Larut Malam / Hening (Gelap Pekat Ramah Mata)", hour


def cmd_roda_waktu(hour: int | None = None, dry_run: bool = False, do_shot: bool = False) -> int:
    """Terapkan tema otomatis mengikuti siklus waktu harian (Roda Waktu)."""
    pid, phase, used_hour = resolve_roda_waktu_preset(hour)
    print(f"[k-look Roda Waktu] Jam {used_hour:02d}:00 -> Fase: {phase}")
    print(f"[k-look Roda Waktu] Tema terpilih: {pid}")
    return cmd_apply(pid, do_shot=do_shot, dry_run=dry_run)


def main():
    parser = argparse.ArgumentParser(
        prog="k-look",
        description="Kalacakra Look - Manajer identitas & tampilan desktop satu perintah",
    )
    parser.add_argument("action", nargs="?", default="list",
                        help="list | pick | gui | roda-waktu | apply <id> | rollback | current | show <id> | share [id] | import <file/url>")
    parser.add_argument("args", nargs="*", help="Argumen tambahan untuk aksi")
    parser.add_argument("--screenshot", "-s", action="store_true",
                        help="Ambil screenshot + caption setelah apply")
    parser.add_argument("--dry-run", "-n", action="store_true",
                        help="Tampilkan langkah yang AKAN dijalankan tanpa mengubah apa pun")
    parser.add_argument("--install", action="store_true",
                        help="Untuk 'import': pasang preset ke direktori preset user")
    parser.add_argument("--gui", "-g", action="store_true",
                        help="Gunakan dialog grafis (kdialog/zenity) untuk memilih tema")
    parser.add_argument("--hour", type=int, default=None,
                        help="Untuk 'roda-waktu'/'auto': paksa jam tertentu (0-23)")
    parsed = parser.parse_args()

    action = parsed.action
    rest = parsed.args
    presets = list_presets()

    if parsed.gui and action in ("list", "pick", "gui"):
        return cmd_gui(presets, do_shot=parsed.screenshot)
    if action in ("list", "ls"):
        return cmd_list(presets)
    if action in ("roda-waktu", "auto"):
        return cmd_roda_waktu(hour=parsed.hour, dry_run=parsed.dry_run, do_shot=parsed.screenshot)
    if action == "gui":
        return cmd_gui(presets, do_shot=parsed.screenshot)
    if action == "pick":
        return cmd_pick(presets)
    if action == "current":
        return cmd_current()
    if action == "rollback":
        return cmd_rollback()
    if action == "show":
        if not rest:
            print("[k-look Error] 'show' butuh id preset.")
            return 1
        return cmd_show(rest[0])
    if action == "share":
        return cmd_share(rest[0] if rest else None)
    if action == "import":
        if not rest:
            print("[k-look Error] 'import' butuh berkas JSON atau URL preset.")
            print("   Contoh: kalacakra look import tema-ku.json --install")
            return 1
        return cmd_import(rest[0], install=parsed.install)
    if action == "apply":
        if not rest:
            print("[k-look Error] 'apply' butuh id preset. Contoh: kalacakra look apply obsidian-minimal")
            return 1
        return cmd_apply(rest[0], do_shot=parsed.screenshot, dry_run=parsed.dry_run)

    print(f"[k-look Error] Aksi tidak dikenal: '{action}'")
    print("   Aksi: list | pick | gui | roda-waktu | apply <id> | rollback | current | show <id> | share [id] | import <file/url>")
    return 1


if __name__ == "__main__":
    sys.exit(main())
