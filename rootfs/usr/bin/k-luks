#!/usr/bin/env python3
"""
Kalacakra OS - k-luks
Pembantu enrollment LUKS2 ke TPM2 (auto-unlock) via systemd-cryptenroll.

CATATAN JUJUR:
- Memerlukan partisi LUKS2 yang sudah ada dan systemd-cryptenroll.
- TPM2 auto-unlock via bootc-image-builder saat ini tidak didukung; ini adalah
  langkah manual pasca-instalasi.
"""

import os, sys, shutil, subprocess, argparse

def have(x): return shutil.which(x) is not None

def status():
    print("=== Kalacakra LUKS / TPM2 ===")
    if have("systemd-cryptenroll"):
        print("systemd-cryptenroll: tersedia")
    else:
        print("systemd-cryptenroll: TIDAK tersedia")
    if have("lsblk"):
        subprocess.run(["lsblk", "-f"])

def enroll(args):
    if not have("systemd-cryptenroll"):
        print("[k-luks Error] 'systemd-cryptenroll' tidak tersedia.")
        return 1
    if not args.device:
        print("[k-luks Error] Sebutkan perangkat LUKS: k-luks enroll --device /dev/nvme0n1p3")
        return 2
    cmd = ["sudo", "systemd-cryptenroll", "--tpm2-device=auto", args.device]
    if args.wipe:
        cmd.insert(2, "--wipe-slot=tpm2")
    r = subprocess.run(cmd)
    return r.returncode

def main():
    ap = argparse.ArgumentParser(prog="k-luks", description="Kalacakra LUKS/TPM2 helper")
    sub = ap.add_subparsers(dest="action")
    sub.add_parser("status", help="Status LUKS/TPM2")
    p_en = sub.add_parser("enroll", help="Enroll LUKS ke TPM2")
    p_en.add_argument("--device", required=True, help="Perangkat LUKS (mis. /dev/nvme0n1p3)")
    p_en.add_argument("--wipe", action="store_true", help="Hapus slot TPM2 lama dulu")
    args = ap.parse_args()
    if args.action == "enroll":
        return enroll(args)
    return status()

if __name__ == "__main__":
    sys.exit(main())
