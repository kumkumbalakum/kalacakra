#!/usr/bin/env python3
"""
Kalacakra OS - Central System Management CLI
Provides a unified entry point for maintenance, recipe execution, and configuration.
"""

import os
import sys
import subprocess
import argparse

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
LIB_PATH = os.path.abspath(os.path.join(SCRIPT_DIR, "..", "share", "kalacakra", "lib"))
if os.path.isdir(LIB_PATH) and LIB_PATH not in sys.path:
    sys.path.insert(0, LIB_PATH)
elif "/usr/share/kalacakra/lib" not in sys.path and os.path.isdir("/usr/share/kalacakra/lib"):
    sys.path.insert(0, "/usr/share/kalacakra/lib")

try:
    from kalacakra_common import get_locale_strings
except ImportError:
    def get_locale_strings(lang_override=None):
        return {}, "en"

def find_justfile() -> str:
    candidates = [
        "/usr/share/kalacakra/Justfile",
        os.path.abspath(os.path.join(SCRIPT_DIR, "..", "share", "kalacakra", "Justfile")),
        os.path.abspath(os.path.join(SCRIPT_DIR, "..", "..", "Justfile")),
        os.path.abspath("Justfile")
    ]
    for c in candidates:
        if os.path.isfile(c):
            return c
    return "/usr/share/kalacakra/Justfile"

def find_bin(name: str) -> str:
    candidates = [
        f"/usr/bin/{name}",
        os.path.join(SCRIPT_DIR, name)
    ]
    for c in candidates:
        if os.path.isfile(c):
            return c
    return name

def main():
    parser = argparse.ArgumentParser(
        prog="kalacakra",
        description="Kalacakra OS Central System Management CLI"
    )
    parser.add_argument("--lang", choices=["id", "en"], help="Override display language")
    subparsers = parser.add_subparsers(dest="command", help="System command to execute")

    subparsers.add_parser("update", help="Update host OS, Flatpak, Homebrew, and Spaces")
    subparsers.add_parser("clean", help="Clean unused Flatpak runtimes, caches, and dangling containers")
    subparsers.add_parser("doctor", help="Run comprehensive system health check")
    
    p_model = subparsers.add_parser("install-model", help="Download local Ollama AI model")
    p_model.add_argument("model", nargs="?", default="llama3.2:1b", help="Model name (e.g. llama3.2:1b, qwen2.5:3b)")

    p_wmodel = subparsers.add_parser("install-whisper-model", help="Download whisper.cpp model for offline voice dictation (k-voice)")
    p_wmodel.add_argument("size", nargs="?", default="small", choices=["tiny", "base", "small", "medium"], help="Model size (default: small)")

    p_scx = subparsers.add_parser("scx", help="Switch dynamic CPU scheduler (sched-ext)")
    p_scx.add_argument("scheduler", choices=["lavd", "rusty", "default"], help="Scheduler target (lavd/rusty/default)")

    p_rebase = subparsers.add_parser("rebase", help="Rebase OS image to another target without reinstall")
    p_rebase.add_argument("target", choices=["nvidia", "base"], help="Target variant (nvidia/base)")

    p_bat = subparsers.add_parser("battery-cap", help="Set battery charge limit percentage")
    p_bat.add_argument("limit", nargs="?", default="80", help="Charge limit percentage (default 80)")

    p_lang = subparsers.add_parser("lang", help="Switch system language")
    p_lang.add_argument("code", choices=["id", "en"], help="Language code (id/en)")

    # 6 Fitur Baru
    p_rewind = subparsers.add_parser("rewind", help="Kalacakra Rewind - Time-travel file recovery & snapshot browser")
    p_rewind.add_argument("subaction", nargs="*", help="Rewind arguments (list/create/restore/diff)")

    p_portal = subparsers.add_parser("portal", help="Kalacakra Portal - Turn any tablet into wireless second screen")
    p_portal.add_argument("subaction", choices=["start", "stop", "status", "toggle"], nargs="?", default="toggle")

    p_beam = subparsers.add_parser("beam", help="Kalacakra Beam - P2P mesh local file transfer")
    p_beam.add_argument("subaction", nargs="*", help="Beam arguments (send/receive)")

    subparsers.add_parser("ocr", help="Kalacakra OCR - AI smart screenshot with local OCR")

    p_surv = subparsers.add_parser("survival", help="Kalacakra Survival - Ultra-battery emergency mode")
    p_surv.add_argument("subaction", choices=["on", "off", "toggle", "status"], nargs="?", default="toggle")

    subparsers.add_parser("precache", help="Kalacakra Precache - Vulkan DXVK anti-stutter shader pre-compiler")

    # 5 Fitur Ergonomi macOS
    p_prev = subparsers.add_parser("preview", help="Kalacakra Quick Look - Instant file previewer")
    p_prev.add_argument("file", help="File path to preview")

    p_spot = subparsers.add_parser("spotlight", help="Kalacakra Spotlight - Math, conversion & natural language router")
    p_spot.add_argument("query", nargs="*", help="Query to evaluate or ask")

    p_flow = subparsers.add_parser("flow", help="Kalacakra Flow - Universal Control cross-device mouse/keyboard sharing")
    p_flow.add_argument("subaction", nargs="*", help="Flow action (server/client/stop/status)")

    p_snip = subparsers.add_parser("snippet", help="Kalacakra Snippet - Global text replacement & expansion")
    p_snip.add_argument("subaction", nargs="*", help="Snippet action (list/add/remove)")

    p_key = subparsers.add_parser("keyring", help="Kalacakra Keyring - Zero-friction PAM auto-unlock & Touch ID")
    p_key.add_argument("subaction", nargs="*", help="Keyring action (status/enroll-finger/setup)")

    # 5 Fitur openSUSE (YaST, openQA, Snapper Boot, Patterns, OBS 1-Click)
    p_hub = subparsers.add_parser("hub", help="Kalacakra Control Hub - YaST-style centralized management TUI")
    p_hub.add_argument("subaction", nargs="*", help="Hub arguments (--status)")

    p_qa = subparsers.add_parser("qa", help="Kalacakra QA - openQA-style automated system regression tests")
    p_qa.add_argument("subaction", nargs="*", help="QA arguments (--json)")

    p_sb = subparsers.add_parser("snapboot", help="Kalacakra SnapBoot - Snapper bootloader snapshot integration")
    p_sb.add_argument("subaction", nargs="*", help="SnapBoot action (list/sync/select)")

    p_prof = subparsers.add_parser("profile", help="Kalacakra Profile - Zypper Patterns-style workload stacks")
    p_prof.add_argument("subaction", nargs="*", help="Profile action (list/apply)")

    p_pkg = subparsers.add_parser("pkg", help="Kalacakra 1-Click - OBS-style package & scheme installer")
    p_pkg.add_argument("target", nargs="*", help="Package file, name, or kalacakra:// URL")

    # 5 Fitur Ketangguhan UNIX FreeBSD (Jails, bectl, Scrub, DTrace, sysrc)
    p_jail = subparsers.add_parser("jail", help="Kalacakra Jail - FreeBSD Jails-style ephemeral micro-sandbox")
    p_jail.add_argument("subaction", nargs="*", help="Jail arguments (--no-net/--pure/command)")

    p_be = subparsers.add_parser("be", help="Kalacakra BE - FreeBSD bectl-style Boot Environment manager")
    p_be.add_argument("subaction", nargs="*", help="BE arguments (list/create/activate/destroy)")

    p_scr = subparsers.add_parser("scrub", help="Kalacakra Scrub - ZFS-style Btrfs data integrity & bitrot guard")
    p_scr.add_argument("subaction", nargs="*", help="Scrub arguments (status/start/cancel)")

    p_trc = subparsers.add_parser("trace", help="Kalacakra Trace - FreeBSD DTrace-style dynamic system profiler")
    p_trc.add_argument("subaction", nargs="*", help="Trace target (io/game/battery)")

    p_src = subparsers.add_parser("sysrc", help="Kalacakra sysrc - FreeBSD sysrc-style safe atomic config manager")
    p_src.add_argument("subaction", nargs="*", help="sysrc assignment (key=val or key)")

    # 5 Fitur Keamanan Legendaris OpenBSD (unveil/pledge, signify, pf, doas, W^X)
    p_unv = subparsers.add_parser("unveil", help="Kalacakra Unveil - OpenBSD unveil/pledge filesystem path restriction")
    p_unv.add_argument("subaction", nargs="*", help="Unveil arguments (--ro/--rw/--hide-home/--no-net/command)")

    p_sig = subparsers.add_parser("signify", help="Kalacakra Signify - OpenBSD signify Ed25519 cryptographic verifier")
    p_sig.add_argument("subaction", nargs="*", help="Signify action (generate/sign/verify/status)")

    p_pf = subparsers.add_parser("pf", help="Kalacakra PF - OpenBSD pf-style firewall and panic killswitch")
    p_pf.add_argument("subaction", nargs="*", help="PF arguments (status/panic/unpanic/block-app/load)")

    p_doas = subparsers.add_parser("doas", help="Kalacakra doas - OpenBSD doas safe privilege elevation")
    p_doas.add_argument("subaction", nargs="*", help="doas arguments (exec/check/init/status)")

    p_wx = subparsers.add_parser("wx", help="Kalacakra W^X - OpenBSD W^X memory exploit mitigation auditor")
    p_wx.add_argument("subaction", nargs="*", help="W^X arguments (audit/scan/check-kernel/enforce)")

    p_vo = subparsers.add_parser("voice", help="Kalacakra Voice - Offline voice dictation via whisper.cpp")
    p_vo.add_argument("subaction", nargs="*", help="Voice arguments (--duration/--model/--lang)")

    p_game = subparsers.add_parser("game", help="Kalacakra Game - Launch Windows .exe via Proton UMU (umu-run)")
    p_game.add_argument("subaction", nargs="*", help="Game arguments (exe path / --game-id / --proton / --store)")

    args, unknown = parser.parse_known_args()
    strings, current_lang = get_locale_strings(args.lang)

    justfile = find_justfile()

    if not args.command:
        print("=== Kalacakra OS Control CLI ===")
        if current_lang == "id":
            print("Gunakan 'kalacakra --help' untuk melihat daftar perintah.")
        else:
            print("Use 'kalacakra --help' to see available commands.")
        
        if os.path.isfile(justfile):
            subprocess.run(["just", "--justfile", justfile, "--list"])
        sys.exit(0)

    # Route commands to executables
    if args.command == "doctor":
        sys.exit(subprocess.run([find_bin("k-doctor")]).returncode)
    elif args.command == "rewind":
        sys.exit(subprocess.run([find_bin("k-rewind")] + args.subaction).returncode)
    elif args.command == "portal":
        sys.exit(subprocess.run([find_bin("k-portal"), args.subaction]).returncode)
    elif args.command == "beam":
        sys.exit(subprocess.run([find_bin("k-beam")] + args.subaction).returncode)
    elif args.command == "ocr":
        sys.exit(subprocess.run([find_bin("k-ocr")]).returncode)
    elif args.command == "survival":
        sys.exit(subprocess.run([find_bin("k-survival"), args.subaction]).returncode)
    elif args.command == "precache":
        sys.exit(subprocess.run([find_bin("k-precache"), "run"]).returncode)
    elif args.command == "preview":
        sys.exit(subprocess.run([find_bin("k-preview"), args.file]).returncode)
    elif args.command == "spotlight":
        sys.exit(subprocess.run([find_bin("k-spotlight")] + args.query).returncode)
    elif args.command == "flow":
        sys.exit(subprocess.run([find_bin("k-flow")] + args.subaction).returncode)
    elif args.command == "snippet":
        sys.exit(subprocess.run([find_bin("k-snippet")] + args.subaction).returncode)
    elif args.command == "keyring":
        sys.exit(subprocess.run([find_bin("k-keyring")] + args.subaction).returncode)
    elif args.command == "hub":
        sys.exit(subprocess.run([find_bin("k-hub")] + args.subaction).returncode)
    elif args.command == "qa":
        sys.exit(subprocess.run([find_bin("k-qa")] + args.subaction).returncode)
    elif args.command == "snapboot":
        sys.exit(subprocess.run([find_bin("k-snapboot")] + args.subaction).returncode)
    elif args.command == "profile":
        sys.exit(subprocess.run([find_bin("k-profile")] + args.subaction).returncode)
    elif args.command == "pkg":
        sys.exit(subprocess.run([find_bin("k-pkg")] + args.target).returncode)
    elif args.command == "jail":
        sys.exit(subprocess.run([find_bin("k-jail")] + args.subaction).returncode)
    elif args.command == "be":
        sys.exit(subprocess.run([find_bin("k-be")] + args.subaction).returncode)
    elif args.command == "scrub":
        sys.exit(subprocess.run([find_bin("k-scrub")] + args.subaction).returncode)
    elif args.command == "trace":
        sys.exit(subprocess.run([find_bin("k-trace")] + args.subaction).returncode)
    elif args.command == "sysrc":
        sys.exit(subprocess.run([find_bin("k-sysrc")] + args.subaction).returncode)
    elif args.command == "unveil":
        sys.exit(subprocess.run([find_bin("k-unveil")] + args.subaction).returncode)
    elif args.command == "signify":
        sys.exit(subprocess.run([find_bin("k-signify")] + args.subaction).returncode)
    elif args.command == "pf":
        sys.exit(subprocess.run([find_bin("k-pf")] + args.subaction).returncode)
    elif args.command == "doas":
        sys.exit(subprocess.run([find_bin("k-doas")] + args.subaction).returncode)
    elif args.command == "wx":
        sys.exit(subprocess.run([find_bin("k-wx")] + args.subaction).returncode)
    elif args.command == "voice":
        sys.exit(subprocess.run([find_bin("k-voice")] + args.subaction).returncode)
    elif args.command == "game":
        sys.exit(subprocess.run([find_bin("k-game")] + args.subaction).returncode)
    elif args.command == "update":
        sys.exit(subprocess.run(["just", "--justfile", justfile, "update"]).returncode)
    elif args.command == "clean":
        sys.exit(subprocess.run(["just", "--justfile", justfile, "clean"]).returncode)
    elif args.command == "install-model":
        sys.exit(subprocess.run(["just", "--justfile", justfile, "install-model", f"model={args.model}"]).returncode)
    elif args.command == "install-whisper-model":
        sys.exit(subprocess.run(["just", "--justfile", justfile, "install-whisper-model", f"size={args.size}"]).returncode)
    elif args.command == "scx":
        sys.exit(subprocess.run(["just", "--justfile", justfile, "scx", f"scheduler={args.scheduler}"]).returncode)
    elif args.command == "rebase":
        sys.exit(subprocess.run(["just", "--justfile", justfile, "rebase", f"target={args.target}"]).returncode)
    elif args.command == "battery-cap":
        sys.exit(subprocess.run(["just", "--justfile", justfile, "battery-cap", f"limit={args.limit}"]).returncode)
    elif args.command == "lang":
        sys.exit(subprocess.run(["just", "--justfile", justfile, "lang", f"code={args.code}"]).returncode)

if __name__ == "__main__":
    main()
