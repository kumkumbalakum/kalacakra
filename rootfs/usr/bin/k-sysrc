#!/usr/bin/env python3
"""
Kalacakra OS - k-sysrc (Safe Configuration Variable Manager)
FreeBSD sysrc-inspired atomic, typed configuration manager.
Safely inspects and modifies Kalacakra OS system variables without editing config files by hand.
"""

import os
import sys
import json
import copy
import argparse

if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
# Path library bersama ditangani oleh _kalacakra_bootstrap.

# Bootstrap bersama (menggantikan boilerplate sys.path + fallback import).
from _kalacakra_bootstrap import get_locale_strings

CONFIG_FILE = os.path.expanduser("~/.config/kalacakra/system.conf")

DEFAULT_CONFIG = {
    "battery.limit": {"val": "80", "type": "int", "desc": "Ambang batas pengisian daya baterai laptop (%)"},
    "ai.killswitch": {"val": "false", "type": "bool", "desc": "Sakelar pemutus instan seluruh daemon AI"},
    "scx.scheduler": {"val": "lavd", "type": "choice", "choices": ["lavd", "rusty", "default"], "desc": "Penjadwal CPU dinamis eBPF"},
    "security.usbguard_lock": {"val": "true", "type": "bool", "desc": "Blokir perangkat USB baru saat layar terkunci"},
    "system.language": {"val": "id", "type": "choice", "choices": ["id", "en"], "desc": "Bahasa antarmuka sistem (id/en)"},
    "btrfs.autocommit": {"val": "30", "type": "int", "desc": "Interval flush commit berkas Btrfs (detik)"}
}

def load_config() -> dict:
    # deepcopy agar mutasi tidak mengubah DEFAULT_CONFIG di memori (aman dipanggil berulang)
    cfg = copy.deepcopy(DEFAULT_CONFIG)
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                saved = json.load(f)
                for k, v in saved.items():
                    if k in cfg:
                        cfg[k]["val"] = str(v)
        except Exception:
            pass
    return cfg

def save_config(cfg: dict):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    clean_data = {k: v["val"] for k, v in cfg.items()}
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(clean_data, f, indent=2, ensure_ascii=False)

def show_config():
    cfg = load_config()
    print()
    print("=" * 72)
    print("=== [Kalacakra sysrc] Variabel Konfigurasi Sistem (Ala FreeBSD) ===")
    print("=" * 72)
    print(f" {'VARIABEL / KEY':<26} {'NILAI':<14} {'DESKRIPSI'}")
    print("-" * 72)
    for k, v in sorted(cfg.items()):
        print(f" {k:<26} {v['val']:<14} {v['desc']}")
    print("-" * 72)
    print("Ubah nilai dengan perintah: k-sysrc <variable>=<value>")
    print("Contoh: k-sysrc battery.limit=85")
    print("=" * 72)
    print()

def set_variable(assignment: str):
    strings, current_lang = get_locale_strings()
    if "=" not in assignment:
        print("[k-sysrc Error] Format salah. Gunakan: <kunci>=<nilai> (misal: battery.limit=80)")
        sys.exit(1)

    key, val = assignment.split("=", 1)
    key = key.strip()
    val = val.strip()

    cfg = load_config()
    if key not in cfg:
        print(f"[k-sysrc Error] Variabel '{key}' tidak terdaftar.")
        print(f"Variabel yang didukung: {', '.join(cfg.keys())}")
        sys.exit(1)

    entry = cfg[key]
    # Validasi tipe
    if entry["type"] == "bool":
        if val.lower() not in ["true", "false", "yes", "no", "1", "0"]:
            print(f"[k-sysrc Error] Nilai untuk '{key}' harus berupa boolean (true/false).")
            sys.exit(1)
        val = "true" if val.lower() in ["true", "yes", "1"] else "false"
    elif entry["type"] == "choice":
        if val.lower() not in entry.get("choices", []):
            print(f"[k-sysrc Error] Nilai '{val}' tidak valid. Pilihan: {', '.join(entry['choices'])}")
            sys.exit(1)
        val = val.lower()
    elif entry["type"] == "int":
        try:
            n = int(val)
        except ValueError:
            print(f"[k-sysrc Error] Nilai untuk '{key}' harus berupa angka bulat.")
            sys.exit(1)
        # Validasi rentang untuk variabel terikat hardware
        if key == "battery.limit" and not (10 <= n <= 100):
            print("[k-sysrc Error] 'battery.limit' harus antara 10 dan 100 (%).")
            sys.exit(1)
        if key == "btrfs.autocommit" and n < 1:
            print("[k-sysrc Error] 'btrfs.autocommit' harus >= 1 detik.")
            sys.exit(1)
        val = str(n)

    entry["val"] = val
    save_config(cfg)
    msg = strings.get("sysrc_updated", "Variabel '{key}' berhasil diperbarui menjadi '{val}'!").format(key=key, val=val)
    print(f"[k-sysrc OK] {msg}")

def get_variable(key: str):
    cfg = load_config()
    if key in cfg:
        print(f"{key}: {cfg[key]['val']}")
    else:
        print(f"[k-sysrc Error] Variabel '{key}' tidak ditemukan.")
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(
        prog="k-sysrc",
        description="Kalacakra sysrc - FreeBSD sysrc-style Safe Atomic Configuration Manager"
    )
    parser.add_argument("assignment", nargs="?", help="Variable assignment (e.g. battery.limit=85) or name to get")
    parser.add_argument("-a", "--all", action="store_true", help="Show all variables and values")

    args = parser.parse_args()

    if args.all or not args.assignment:
        show_config()
    elif "=" in args.assignment:
        set_variable(args.assignment)
    else:
        get_variable(args.assignment)

if __name__ == "__main__":
    main()
