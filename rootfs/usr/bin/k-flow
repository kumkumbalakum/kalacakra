#!/usr/bin/env python3
"""
Kalacakra OS - k-flow
Universal Control Engine (Cross-Device Mouse & Keyboard Roaming)
Allows one mouse and keyboard to smoothly glide across nearby Linux, Mac, and Windows PCs on local Wi-Fi.
"""

import os
import sys
import subprocess
import argparse

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))

PID_FILE = "/tmp/kalacakra-flow.pid"
CONFIG_FILE = os.path.expanduser("~/.config/kalacakra/flow.conf")

# Deskflow adalah penerus Barrier; nama biner server & klien berbeda antar paket.
# Cek ketersediaan di muka agar pesan error akurat, bukan gagal setelah Popen.
SERVER_BINARIES = ("deskflow", "barriers", "barrier")
CLIENT_BINARIES = ("deskflow", "barrierc", "barrier")

def shutil_which(cmd: str) -> bool:
    import shutil
    return shutil.which(cmd) is not None

def find_first_available(candidates) -> str:
    """Kembalikan biner pertama yang tersedia di PATH, atau None."""
    for c in candidates:
        if shutil_which(c):
            return c
    return None

def ensure_config():
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    if not os.path.isfile(CONFIG_FILE):
        content = """section: screens
    kalacakra-host:
    remote-laptop:
end
section: links
    kalacakra-host:
        right = remote-laptop
    remote-laptop:
        left = kalacakra-host
end
"""
        with open(CONFIG_FILE, "w") as f:
            f.write(content)

def start_server(port: int = 24800):
    ensure_config()
    print("=" * 60)
    print("=== [Kalacakra Flow] Universal Control Server Active ===")
    print("=" * 60)
    print(f"Port Listener : {port}")
    print(f"Konfigurasi   : {CONFIG_FILE}")
    print("-" * 60)
    print("Mouse dan keyboard laptop ini siap dibagikan ke layar PC lain di sebelah!")
    print("Di laptop kedua (Windows/Mac/Linux), hubungkan ke IP laptop ini via Barrier/Deskflow.")
    print("-" * 60)

    binary = find_first_available(SERVER_BINARIES)
    if binary:
        proc = subprocess.Popen([binary, "-f", "--config", CONFIG_FILE, "--address", f":{port}"])
        with open(PID_FILE, "w") as f:
            f.write(str(proc.pid))
        print(f"[k-flow] Backend aktif: {binary} (PID {proc.pid})")
    else:
        print("[k-flow Error] 'deskflow' atau 'barrier' tidak terpasang - server TIDAK berjalan.")
        print("[k-flow] Pasang salah satu terlebih dahulu, misalnya:")
        print("         sudo rpm-ostree install deskflow   (atau barrier)")
        sys.exit(1)

def connect_client(server_ip: str, port: int = 24800):
    print(f"[Kalacakra Flow] Menghubungkan mouse/keyboard ke server di {server_ip}:{port}...")
    binary = find_first_available(CLIENT_BINARIES)
    if binary:
        proc = subprocess.Popen([binary, "-f", f"{server_ip}:{port}"])
        with open(PID_FILE, "w") as f:
            f.write(str(proc.pid))
        print(f"[k-flow] Terhubung ke {server_ip}:{port} via {binary} (PID {proc.pid})")
    else:
        print("[k-flow Error] 'deskflow' atau 'barrierc' tidak terpasang - koneksi TIDAK dibuat.")
        print("[k-flow] Pasang salah satu terlebih dahulu, misalnya:")
        print("         sudo rpm-ostree install deskflow   (atau barrier)")
        sys.exit(1)

def kill_process(name: str):
    if shutil_which("pkill"):
        try:
            subprocess.run(["pkill", "-f", name], check=False)
        except Exception:
            pass

def is_process_running(name: str) -> bool:
    if shutil_which("pgrep"):
        try:
            return subprocess.run(["pgrep", "-f", name], capture_output=True).returncode == 0
        except Exception:
            return False
    return False

def stop_flow():
    if os.path.isfile(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 15)
            os.remove(PID_FILE)
        except Exception:
            pass
    kill_process("deskflow")
    kill_process("barrier")
    print("[Kalacakra Flow] Layanan Universal Control dinonaktifkan.")

def main():
    parser = argparse.ArgumentParser(
        prog="k-flow",
        description="Kalacakra Flow - Universal Control Mouse & Keyboard Sharing"
    )
    subparsers = parser.add_subparsers(dest="command")

    p_srv = subparsers.add_parser("server", help="Run as host server (share mouse/keyboard to other PCs)")
    p_srv.add_argument("--port", type=int, default=24800, help="Port (default 24800)")

    p_cli = subparsers.add_parser("client", help="Connect to another PC server")
    p_cli.add_argument("server_ip", help="IP address of master PC")
    p_cli.add_argument("--port", type=int, default=24800, help="Port (default 24800)")

    subparsers.add_parser("stop", help="Stop Kalacakra Flow daemon")
    subparsers.add_parser("status", help="Check Kalacakra Flow status")

    args = parser.parse_args()

    if not args.command or args.command == "server":
        start_server(getattr(args, "port", 24800))
    elif args.command == "client":
        connect_client(args.server_ip, getattr(args, "port", 24800))
    elif args.command == "stop":
        stop_flow()
    elif args.command == "status":
        running_backends = [b for b in ("deskflow", "barrier", "barriers", "barrierc") if is_process_running(b)]
        active = os.path.isfile(PID_FILE) or bool(running_backends)
        backend = ", ".join(running_backends) if running_backends else "-"
        print(f"[k-flow] Status: {'AKTIF' if active else 'NONAKTIF'} (backend: {backend})")


if __name__ == "__main__":
    main()
