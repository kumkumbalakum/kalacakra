#!/usr/bin/env python3
"""
Kalacakra OS - k-preview (Quick Look)
Press Spacebar on any file in Dolphin to instantly preview:
Markdown, PDF, Images, Audio, Video, Archives, or Syntax-Highlighted Code.
"""

import os
import sys
import shutil
import subprocess
import mimetypes

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))

def preview_file(file_path: str):
    if not os.path.exists(file_path):
        print(f"[k-preview Error] Berkas '{file_path}' tidak ditemukan.")
        sys.exit(1)

    mime, _ = mimetypes.guess_type(file_path)
    mime = mime or "text/plain"
    ext = os.path.splitext(file_path)[1].lower()

    # 1. Gambar
    if mime.startswith("image/"):
        if shutil.which("gwenview"):
            subprocess.Popen(["gwenview", file_path])
            return
        elif shutil.which("feh"):
            subprocess.Popen(["feh", "-.", file_path])
            return

    # 2. Markdown
    if ext in [".md", ".markdown"]:
        if shutil.which("glow"):
            subprocess.run(["glow", "-p", file_path])
            return

    # 3. PDF
    if ext == ".pdf":
        if shutil.which("okular"):
            subprocess.Popen(["okular", "--unique", file_path])
            return

    # 4. Arsip (Zip / Tar)
    if ext in [".zip", ".tar", ".gz", ".xz", ".bz2", ".7z"]:
        print(f"=== [Kalacakra Quick Look] Isi Arsip: {os.path.basename(file_path)} ===")
        if ext == ".zip":
            if shutil.which("unzip"):
                subprocess.run(["unzip", "-l", file_path], check=False)
            else:
                subprocess.run([sys.executable, "-m", "zipfile", "-l", file_path], check=False)
        else:
            subprocess.run(["tar", "-tvf", file_path], check=False)
        return

    # 5. Kode atau Teks Umum (bat with syntax highlight)
    # Hindari menampilkan biner mentah: tebak dari mime
    if mime.startswith(("audio/", "video/", "font/")):
        print(f"[k-preview] Pratinjau {mime} belum didukung CLI. Buka dengan aplikasi default:")
        print(f"  xdg-open \"{file_path}\"")
        return
    if shutil.which("bat"):
        subprocess.run(["bat", "--style=header,grid", file_path])
    elif shutil.which("less"):
        subprocess.run(["less", "-R", file_path])
    else:
        # Fallback terakhir: cetak sendiri dengan nomor baris, jangan crash
        # karena bat/less mungkin tidak terpasang di image minimal.
        try:
            with open(file_path, "r", encoding="utf-8", errors="replace") as f:
                for i, line in enumerate(f, 1):
                    print(f"{i:>5}  {line}", end="")
        except OSError as e:
            print(f"[k-preview] Tidak bisa membaca '{file_path}': {e}")


def main():
    if len(sys.argv) < 2:
        print("Penggunaan / Usage: k-preview <nama_berkas>")
        print("Atau tekan tombol 'Spasi' di file manager Dolphin.")
        sys.exit(0)

    target_file = sys.argv[1]
    preview_file(target_file)

if __name__ == "__main__":
    main()
