[Desktop Entry]
Type=Service
MimeType=text/plain;text/markdown;text/x-python;application/json;application/x-shellscript;text/x-log;
Actions=AiSummarize;
X-KDE-Priority=TopLevel
Name=Kalacakra AI
Name[id]=Kalacakra AI

[Desktop Action AiSummarize]
Name=Summarize with Local AI (Kalacakra k-ai)
Name[id]=Ringkas dengan AI Lokal (Kalacakra k-ai)
Icon=system-search
Exec=/usr/bin/k-ai --file %f
