[Desktop Entry]
Type=Service
MimeType=all/allfiles;application/octet-stream;
Actions=BeamFile;
X-KDE-Priority=TopLevel
Name=Kalacakra Beam
Name[id]=Kalacakra Beam

[Desktop Action BeamFile]
Name=Beam to Device... (Kalacakra Beam)
Name[id]=Beam ke Perangkat... (Kalacakra Beam)
Icon=network-wireless
Exec=/usr/bin/k-beam send %f
