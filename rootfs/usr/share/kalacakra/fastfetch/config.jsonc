{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/kalacakra/fastfetch/kalacakra-mandala.ascii",
    "type": "file",
    "color": {
      "1": "yellow",
      "2": "cyan"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    {
      "type": "command",
      "key": "AI Engine",
      "text": "systemctl --user is-active kalacakra-ai.service 2>/dev/null || echo 'inactive'"
    },
    {
      "type": "command",
      "key": "CPU Scheduler",
      "text": "pgrep -a scx | head -n 1 | awk '{print $2}' || echo 'default (EEVDF)'"
    },
    "break",
    "colors"
  ]
}
